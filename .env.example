# Copy this file to .env and fill in your values. Never commit .env.

# Public address used in emails and certificate QR codes (leave empty for local testing)
PUBLIC_SITE_URL=

# Secret used to sign login sessions - use a long random string in production
JWT_SECRET=

# Outgoing email (SMTP).
# Best for reaching the INBOX: send from your own domain through Brevo (arshithgroup.com is already
# verified there with DKIM). Brevo dashboard -> SMTP & API -> SMTP tab: copy the login and create an SMTP key.
#   SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587   SMTP_SECURE=false
#   SMTP_USER=<your Brevo SMTP login>   SMTP_PASS=<your Brevo SMTP key>
#   MAIL_FROM=CodeLekho <no-reply@arshithgroup.com>
# A personal Gmail address also works (App Password at https://myaccount.google.com/apppasswords),
# but codes from a free mailbox with a brand name are often sent to spam.
# Alternative when the server's network blocks SMTP ports: send over HTTPS with a Brevo API key
# (Brevo > SMTP & API > API keys). When set it is used instead of the SMTP lines below.
# BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
MAIL_FROM=CodeLekho <no-reply@arshithgroup.com>

# Supabase database (optional). Leave empty to keep using server/data/db.json.
# Supabase dashboard -> Project Settings -> API: copy the Project URL and the secret key
# ("service_role" or "sb_secret_..."). Keep the secret key private - never put it in frontend code.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Admin login: your admin email and password (applied when the server starts; at least 8 characters).
# Sign in on the normal login page (/login) with this email.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Online payment (Cashfree). Merchant Dashboard > Developers > API Keys. On the server,
# bash scripts/set-cashfree.sh fills these in. CASHFREE_ENV=production for real payments, sandbox to test.
# Leave the keys empty to keep "contact us to enrol". Optional webhook: Developers > Webhooks,
# URL https://codelekho.com/api/payments/webhook (signed with the same secret key).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Pricing: each course costs 99, Data Science 199. COURSE_PRICE overrides every course (e.g. 1 for a test payment).
# Interview Prep costs INTERVIEW_PRICE (default 599), or is free with certificates for all 4 courses.
# PAID_COURSES=off makes every course free. Set a price to 1 to try a real payment cheaply.
COURSE_PRICE=
INTERVIEW_PRICE=

# Interview Prep needs 4 course certificates. Set to "off" to open it for every signed-in learner.
INTERVIEW_LOCK=on
