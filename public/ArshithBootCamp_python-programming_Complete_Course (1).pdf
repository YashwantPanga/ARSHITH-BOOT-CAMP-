T* (print\("'listen' and 'silent' are anagrams?", are_anagrams\("listen", "silent"\)\)) Tj
T* () Tj
T* (# Program 3: CamelCase to snake_case) Tj
T* (def camel_to_snake\(name\):) Tj
T* (result = []) Tj
T* (for char in name:) Tj
T* (if char.isupper\(\):) Tj
T* (result.append\("_" + char.lower\(\)\)) Tj
T* (else:) Tj
T* (result.append\(char\)) Tj
T* (return "".join\(result\).lstrip\("_"\)) Tj
T* () Tj
T* (def snake_to_camel\(name\):) Tj
T* (parts = name.split\("_"\)) Tj
T* (return parts[0] + "".join\(p.capitalize\(\) for p in parts[1:]\)) Tj
T* () Tj
T* (print\("\\n--- Program 3: Case Conversion ---"\)) Tj
T* (camel = "userRegistrationDate") Tj
T* (snake = camel_to_snake\(camel\)) Tj
T* (print\(f"Camel to Snake: {camel} -> {snake}"\)) Tj
