(import time) Tj
T* () Tj
T* (# Immutability: constructing a modified string) Tj
T* (original = "Hello World") Tj
T* (# original[0] = 'J' -> TypeError!) Tj
T* (modified = "J" + original[1:]) Tj
T* (print\("Modified string:", modified\)) Tj
T* () Tj
T* (# Quadratic concatenation vs Linear str.join\(\)) Tj
T* (words = ["python"] * 10000) Tj
T* () Tj
T* (# 1. Quadratic loop concatenation) Tj
T* (start = time.perf_counter\(\)) Tj
T* (quad_result = "") Tj
T* (for w in words:) Tj
T* (quad_result += w) Tj
T* (time_quad = time.perf_counter\(\) - start) Tj
T* () Tj
T* (# 2. Linear join) Tj
T* (start = time.perf_counter\(\)) Tj
T* (join_result = "".join\(words\)) Tj
T* (time_join = time.perf_counter\(\) - start) Tj
T* () Tj
T* (print\(f"str.join\(\) was {time_quad / max\(time_join, 1e-9\):.1f}x faster than loop '+=') Tj
T* (concatenation!"\)) Tj
