(import json) Tj
T* (from datetime import datetime) Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 1: Inventory Item with Property Validation) Tj
T* (# ==============================================================================) Tj
T* (class InventoryItem:) Tj
T* (def __init__\(self, item_id, name, unit_price, quantity_in_stock=0\):) Tj
T* (self.item_id = item_id) Tj
T* (self.name = name) Tj
T* (self.unit_price = unit_price) Tj
T* (self.quantity_in_stock = quantity_in_stock) Tj
T* () Tj
T* (@property) Tj
T* (def unit_price\(self\):) Tj
T* (return self._unit_price) Tj
T* () Tj
T* (@unit_price.setter) Tj
T* (def unit_price\(self, val\):) Tj
T* (if val <= 0: raise ValueError\("Unit price must be positive."\)) Tj
T* (self._unit_price = float\(val\)) Tj
T* () Tj
T* (@property) Tj
T* (def quantity_in_stock\(self\):) Tj
T* (return self._quantity) Tj
T* () Tj
T* (@quantity_in_stock.setter) Tj
T* (def quantity_in_stock\(self, val\):) Tj
T* (if val < 0: raise ValueError\("Stock quantity cannot be negative."\)) Tj
T* (self._quantity = int\(val\)) Tj
T* () Tj
T* (@property) Tj
T* (def total_value\(self\):) Tj
T* (return self._unit_price * self._quantity) Tj
T* () Tj
T* (item = InventoryItem\("ITM-101", "Mechanical Keyboard", 85.50, 40\)) Tj
T* (print\("Challenge 1 - Inventory Item:"\)) Tj
T* (print\(f" Item: {item.name} | Total Inventory Value: $" + f"{item.total_value:,.2f}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 2: Bank Account Hierarchy with Transaction Auditing) Tj
T* (# ==============================================================================) Tj
T* (class Account:) Tj
T* (def __init__\(self, owner, initial_balance=0.0\):) Tj
T* (self.owner = owner) Tj
T* (self.balance = float\(initial_balance\)) Tj
T* (self.transactions = []) Tj
T* () Tj
T* (def deposit\(self, amount\):) Tj
T* (if amount <= 0: raise ValueError\("Deposit must be positive."\)) Tj
T* (self.balance += amount) Tj
T* (self.transactions.append\(\(datetime.now\(\).strftime\("%H:%M:%S"\), "DEPOSIT", amount\)\)) Tj
T* (return self.balance) Tj
T* () Tj
T* (def withdraw\(self, amount\):) Tj
T* (if amount <= 0: raise ValueError\("Withdrawal must be positive."\)) Tj
T* (if amount > self.balance: raise ValueError\("Insufficient funds."\)) Tj
T* (self.balance -= amount) Tj
T* (self.transactions.append\(\(datetime.now\(\).strftime\("%H:%M:%S"\), "WITHDRAW", amount\)\)) Tj
T* (return self.balance) Tj
T* () Tj
T* (class SavingsAccount\(Account\):) Tj
T* (MIN_BALANCE = 500.0) Tj
T* () Tj
T* (def withdraw\(self, amount\):) Tj
T* (if \(self.balance - amount\) < self.MIN_BALANCE:) Tj
T* (raise ValueError\(f"Withdrawal denied: must maintain minimum balance of $" + f"{self.MIN_BALANCE}"\)) Tj
T* (return super\(\).withdraw\(amount\)) Tj
T* () Tj
T* (class CheckingAccount\(Account\):) Tj
T* (def __init__\(self, owner, initial_balance=0.0, overdraft_limit=200.0\):) Tj
T* (super\(\).__init__\(owner, initial_balance\)) Tj
T* (self.overdraft_limit = float\(overdraft_limit\)) Tj
T* () Tj
T* (def withdraw\(self, amount\):) Tj
T* (if amount > \(self.balance + self.overdraft_limit\):) Tj
T* (raise ValueError\("Withdrawal exceeds overdraft limit."\)) Tj
T* (self.balance -= amount) Tj
T* (self.transactions.append\(\(datetime.now\(\).strftime\("%H:%M:%S"\), "WITHDRAW", amount\)\)) Tj
T* (return self.balance) Tj
T* () Tj
T* (savings = SavingsAccount\("Ananya", 1000\)) Tj
T* (savings.withdraw\(300\)) Tj
T* (print\(f") Tj
T* (Challenge 2 - Savings Account:"\)) Tj
T* (print\(f" Owner: {savings.owner} | Balance: $" + f"{savings.balance:,.2f} | Transactions:) Tj
T* ({len\(savings.transactions\)}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 3: Vector2D Class with Operator Overloading) Tj
T* (# ==============================================================================) Tj
T* (class Vector2D:) Tj
T* (def __init__\(self, x, y\):) Tj
T* (self.x = float\(x\)) Tj
T* (self.y = float\(y\)) Tj
T* () Tj
T* (def __add__\(self, other\):) Tj
T* (return Vector2D\(self.x + other.x, self.y + other.y\)) Tj
T* () Tj
T* (def __sub__\(self, other\):) Tj
T* (return Vector2D\(self.x - other.x, self.y - other.y\)) Tj
T* () Tj
T* (def __mul__\(self, scalar\):) Tj
T* (return Vector2D\(self.x * scalar, self.y * scalar\)) Tj
T* () Tj
T* (def __eq__\(self, other\):) Tj
T* (return isinstance\(other, Vector2D\) and self.x == other.x and self.y == other.y) Tj
T* () Tj
T* (def __str__\(self\):) Tj
T* (return f"\({self.x:.1f}, {self.y:.1f}\)") Tj
T* () Tj
T* (v1 = Vector2D\(3, 4\)) Tj
T* (v2 = Vector2D\(1, 2\)) Tj
T* (v3 = v1 + v2) Tj
T* (print\(f") Tj
T* (Challenge 3 - Vector Mathematics:"\)) Tj
T* (print\(f" {v1} + {v2} = {v3}"\)) Tj
T* (print\(f" Scaled {v1} * 2.5 = {v1 * 2.5}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 4: Polymorphic Notification Dispatcher) Tj
T* (# ==============================================================================) Tj
T* (class EmailNotifier:) Tj
T* (def send_alert\(self, recipient, message\):) Tj
T* (return f"[EMAIL sent to {recipient}]: {message}") Tj
T* () Tj
T* (class SMSNotifier:) Tj
T* (def send_alert\(self, recipient, message\):) Tj
T* (return f"[SMS sent to {recipient}]: {message}") Tj
T* () Tj
T* (class SlackNotifier:) Tj
T* (def send_alert\(self, recipient, message\):) Tj
T* (return f"[SLACK channel #{recipient}]: {message}") Tj
T* () Tj
T* (def broadcast_system_alert\(notifiers, recipient, alert_msg\):) Tj
T* (logs = []) Tj
T* (for n in notifiers:) Tj
T* (logs.append\(n.send_alert\(recipient, alert_msg\)\)) Tj
T* (return logs) Tj
T* () Tj
T* (dispatchers = [EmailNotifier\(\), SMSNotifier\(\), SlackNotifier\(\)]) Tj
T* (alerts = broadcast_system_alert\(dispatchers, "devops-team", "Node 4 CPU load > 90%"\)) Tj
T* (print\(") Tj
T* (Challenge 4 - Polymorphic Notifications:"\)) Tj
T* (for log in alerts:) Tj
T* (print\(f" - {log}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 5: Alternative Factory Constructor from JSON) Tj
T* (# ==============================================================================) Tj
T* (class CourseModule:) Tj
T* (def __init__\(self, module_id, title, duration_hours\):) Tj
T* (self.module_id = module_id) Tj
T* (self.title = title) Tj
T* (self.duration_hours = int\(duration_hours\)) Tj
T* () Tj
T* (@classmethod) Tj
T* (def from_json_str\(cls, json_payload\):) Tj
T* (parsed = json.loads\(json_payload\)) Tj
T* (return cls\(parsed['id'], parsed['title'], parsed['hours']\)) Tj
T* () Tj
T* (def __repr__\(self\):) Tj
T* (return f"CourseModule\('{self.module_id}', '{self.title}', {self.duration_hours}h\)") Tj
T* () Tj
T* (raw_mod_json = '{"id": "py-mod-11", "title": "Object-Oriented Programming", "hours": 4}') Tj
T* (mod_obj = CourseModule.from_json_str\(raw_mod_json\)) Tj
T* (print\(f") Tj
