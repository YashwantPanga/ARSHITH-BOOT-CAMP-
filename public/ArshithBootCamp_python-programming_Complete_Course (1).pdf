(log_data = """From stephen.marquard@uct.ac.za Sat Jan 5 09:14:16 2008) Tj
T* (Return-Path: <postmaster@collab.sakaiproject.org>) Tj
T* (From: louis@media.berkeley.edu Fri Jan 4 18:10:48 2008) Tj
T* (Subject: [sakai] svn commit: r39772) Tj
T* (From: zqian@umich.edu Fri Jan 4 16:10:39 2008""") Tj
T* () Tj
T* (import re) Tj
T* () Tj
T* (# Goal: Extract only email addresses from lines that begin with 'From: ') Tj
T* (# Pattern anatomy:) Tj
T* (# ^From: -> Must start with 'From: ') Tj
T* (# \(S+@S+\) -> Capture group: non-whitespace, '@', non-whitespace) Tj
T* (pattern = r'^From: \(S+@S+\)') Tj
T* () Tj
T* (for line in log_data.split\(') Tj
T* ('\):) Tj
T* (match = re.search\(pattern, line\)) Tj
T* (if match:) Tj
T* (# group\(1\) retrieves the content inside the parentheses) Tj
T* (extracted_email = match.group\(1\)) Tj
T* (print\(f"Extracted Sender: {extracted_email}"\)) Tj
ET
