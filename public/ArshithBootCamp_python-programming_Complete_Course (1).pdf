(def safe_divide_records\(dividend_str, divisor_str\):) Tj
T* (try:) Tj
T* (a = float\(dividend_str\)) Tj
T* (b = float\(divisor_str\)) Tj
T* (result = a / b) Tj
T* (except ValueError as val_err:) Tj
T* (print\(f"Input Conversion Error: {val_err}"\)) Tj
T* (return None) Tj
T* (except ZeroDivisionError:) Tj
T* (print\("Arithmetic Error: Cannot divide by zero."\)) Tj
T* (return None) Tj
T* (else:) Tj
T* (# Runs ONLY when no exceptions occurred) Tj
T* (print\(f"Calculation Successful: {a} / {b} = {result:.4f}"\)) Tj
T* (return result) Tj
T* (finally:) Tj
T* (# ALWAYS runs regardless of outcome) Tj
T* (print\("Completed safe_divide transaction attempt.) Tj
T* ("\)) Tj
T* () Tj
T* (# Test 1: Clean execution) Tj
T* (safe_divide_records\("100", "4"\)) Tj
T* () Tj
T* (# Test 2: Zero division) Tj
T* (safe_divide_records\("50", "0"\)) Tj
T* () Tj
T* (# Test 3: Invalid text input) Tj
T* (safe_divide_records\("one hundred", "20"\)) Tj
ET
