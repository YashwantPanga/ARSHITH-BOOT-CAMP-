T* (import ssl ctx = ssl.create_default_context\(\) # For internal test labs where CA certs are missing: # ctx.check_hostname = False #) Tj
T* (ctx.verify_mode = ssl.CERT_NONE response = urllib.request.urlopen\('https://data.pr4e.org', context=ctx\)) Tj
