(students = [\("Asha", 88\), \("Ben", 95\), \("Maya", 88\)]) Tj
T* () Tj
T* (# Decorate-Sort-Undecorate \(DSU\) with index tie-breaker) Tj
T* (decorated = [\(score, index, name\) for index, \(name, score\) in enumerate\(students\)]) Tj
T* (decorated.sort\(\)) Tj
T* (dsu_result = [name for score, index, name in decorated]) Tj
T* (print\("DSU sorted by score:", dsu_result\)) Tj
T* () Tj
T* (# Modern sorted\(\) with key) Tj
T* (modern_result = sorted\(students, key=lambda s: s[1]\)) Tj
T* (print\("Modern key sorted:", modern_result\)) Tj
ET
