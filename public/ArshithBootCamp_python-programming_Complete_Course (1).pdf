(class Money:) Tj
T* (def __init__\(self, amount, currency="USD"\):) Tj
T* (self.amount = round\(float\(amount\), 2\)) Tj
T* (self.currency = currency.upper\(\)) Tj
T* () Tj
T* (def __str__\(self\):) Tj
T* (# User readable) Tj
T* (return f"{self.currency} " + f"{self.amount:,.2f}") Tj
T* () Tj
T* (def __repr__\(self\):) Tj
T* (# Developer debug string) Tj
T* (return f"Money\({self.amount}, '{self.currency}'\)") Tj
T* () Tj
T* (def __eq__\(self, other\):) Tj
T* (if not isinstance\(other, Money\): return False) Tj
T* (return self.amount == other.amount and self.currency == other.currency) Tj
T* () Tj
T* (def __add__\(self, other\):) Tj
T* (if not isinstance\(other, Money\):) Tj
T* (raise TypeError\("Cannot add Money to non-Money object"\)) Tj
T* (if self.currency != other.currency:) Tj
T* (raise ValueError\(f"Cannot add mismatched currencies: {self.currency} vs {other.currency}"\)) Tj
T* (return Money\(self.amount + other.amount, self.currency\)) Tj
T* () Tj
T* (m1 = Money\(150.50, "USD"\)) Tj
T* (m2 = Money\(49.50, "USD"\)) Tj
T* (m3 = m1 + m2) Tj
T* () Tj
T* (print\(f"m1: {m1}"\)) Tj
T* (print\(f"m2: {m2}"\)) Tj
T* (print\(f"m3 \(Sum via + operator\): {m3}"\)) Tj
T* (print\(f"Is m3 equal to Money\(200, 'USD'\)? {m3 == Money\(200, 'USD'\)}"\)) Tj
T* (print\(f"Debug representation: {repr\(m3\)}"\)) Tj
