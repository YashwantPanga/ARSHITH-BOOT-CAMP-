(import sqlite3) Tj
T* () Tj
T* (conn = sqlite3.connect\('music_catalog.db'\)) Tj
T* (cur = conn.cursor\(\)) Tj
T* () Tj
T* (cur.executescript\(''') Tj
T* (DROP TABLE IF EXISTS Track;) Tj
T* (DROP TABLE IF EXISTS Album;) Tj
T* (DROP TABLE IF EXISTS Artist;) Tj
T* () Tj
T* (CREATE TABLE Artist \() Tj
T* (id INTEGER PRIMARY KEY AUTOINCREMENT,) Tj
T* (name TEXT UNIQUE NOT NULL) Tj
T* (\);) Tj
T* () Tj
T* (CREATE TABLE Album \() Tj
T* (id INTEGER PRIMARY KEY AUTOINCREMENT,) Tj
T* (title TEXT NOT NULL,) Tj
T* (artist_id INTEGER,) Tj
T* (FOREIGN KEY \(artist_id\) REFERENCES Artist \(id\)) Tj
T* (\);) Tj
T* () Tj
T* (CREATE TABLE Track \() Tj
T* (id INTEGER PRIMARY KEY AUTOINCREMENT,) Tj
T* (title TEXT NOT NULL,) Tj
T* (duration_seconds INTEGER,) Tj
T* (album_id INTEGER,) Tj
T* (FOREIGN KEY \(album_id\) REFERENCES Album \(id\)) Tj
T* (\);) Tj
T* ('''\)) Tj
T* () Tj
T* (# Insert Normalized Entities) Tj
T* (cur.execute\('INSERT INTO Artist \(name\) VALUES \(?\)', \('AC/DC',\)\)) Tj
T* (artist_id = cur.lastrowid) Tj
T* () Tj
T* (cur.execute\('INSERT INTO Album \(title, artist_id\) VALUES \(?, ?\)', \('Back in Black', artist_id\)\)) Tj
T* (album_id = cur.lastrowid) Tj
T* () Tj
T* (cur.execute\('INSERT INTO Track \(title, duration_seconds, album_id\) VALUES \(?, ?, ?\)', \('Hells) Tj
T* (Bells', 312, album_id\)\)) Tj
T* (cur.execute\('INSERT INTO Track \(title, duration_seconds, album_id\) VALUES \(?, ?, ?\)', \('Shoot to) Tj
T* (Thrill', 317, album_id\)\)) Tj
T* (conn.commit\(\)) Tj
T* () Tj
T* (# Multi-Table Relational JOIN Query) Tj
T* (cur.execute\(''') Tj
T* (SELECT Track.title, Album.title, Artist.name, Track.duration_seconds) Tj
T* (FROM Track) Tj
T* (JOIN Album ON Track.album_id = Album.id) Tj
T* (JOIN Artist ON Album.artist_id = Artist.id) Tj
T* ('''\)) Tj
T* () Tj
T* (print\("Relational Query Results:"\)) Tj
T* (for track, album, artist, duration in cur:) Tj
T* (print\(f" Track: '{track}' | Album: '{album}' | Artist: '{artist}' | Length: {duration}s"\)) Tj
T* () Tj
T* (conn.close\(\)) Tj
