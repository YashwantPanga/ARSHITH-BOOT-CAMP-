(from pathlib import Path) Tj
T* () Tj
T* (# Create path references safely across Windows, Linux, and macOS) Tj
T* (project_root = Path.cwd\(\)) Tj
T* (config_file = project_root / "config" / "settings.json") Tj
T* () Tj
T* (print\(f"Path Representation: {config_file}"\)) Tj
T* (print\(f"File Name: {config_file.name}"\)) Tj
T* (print\(f"File Extension: {config_file.suffix}"\)) Tj
T* (print\(f"Stem \(No Extension\): {config_file.stem}"\)) Tj
T* (print\(f"Parent Directory: {config_file.parent}"\)) Tj
T* (print\(f"Is Absolute Path: {config_file.is_absolute\(\)}"\)) Tj
T* () Tj
T* (# Check existence without try/except) Tj
T* (if config_file.exists\(\):) Tj
T* (print\(f"File Size: {config_file.stat\(\).st_size} bytes"\)) Tj
T* (else:) Tj
T* (print\("Target path does not exist on disk."\)) Tj
