T* () Tj
T* (import re) Tj
T* () Tj
T* (# Pattern: Match 'X-DSPAM-Confidence: ' followed by float digits) Tj
T* (# Extract only the float part inside parentheses) Tj
T* (float_pattern = r'^X-DSPAM-Confidence: \([0-9.]+\)') Tj
T* () Tj
T* (confidence_scores = []) Tj
T* (for line in mbox_text.split\(') Tj
T* ('\):) Tj
T* (matches = re.findall\(float_pattern, line\)) Tj
T* (for score_str in matches:) Tj
T* (confidence_scores.append\(float\(score_str\)\)) Tj
T* () Tj
T* (print\(f"Confidence Scores: {confidence_scores}"\)) Tj
T* (print\(f"Total Matches: {len\(confidence_scores\)}"\)) Tj
T* (print\(f"Average Score: {sum\(confidence_scores\) / len\(confidence_scores\):.4f}"\)) Tj
T* (print\(f"Maximum Score: {max\(confidence_scores\):.4f}"\)) Tj
