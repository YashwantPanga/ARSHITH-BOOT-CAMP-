T* (# Program 2: Clean Palindrome & Anagram Verifier) Tj
T* (def is_palindrome\(s\):) Tj
T* (cleaned = "".join\(char.lower\(\) for char in s if char.isalnum\(\)\)) Tj
T* (return cleaned == cleaned[::-1]) Tj
T* () Tj
T* (def are_anagrams\(s1, s2\):) Tj
T* (clean1 = sorted\(char.lower\(\) for char in s1 if char.isalnum\(\)\)) Tj
T* (clean2 = sorted\(char.lower\(\) for char in s2 if char.isalnum\(\)\)) Tj
T* (return clean1 == clean2) Tj
T* () Tj
T* (print\("\\n--- Program 2: Palindrome & Anagram ---"\)) Tj
