(a = 20) Tj
T* (b = 5) Tj
T* (print\("--- Program 1: Calculator ---"\)) Tj
T* (print\("Addition:", a + b\) # 25) Tj
T* (print\("Subtraction:", a - b\) # 15) Tj
T* (print\("Multiplication:", a * b\) # 100) Tj
T* (print\("Division:", a / b\) # 4.0) Tj
T* (print\("Floor Division:", a // b\) # 4) Tj
T* (print\("Remainder \(%\):", a % b\) # 0) Tj
T* (print\("Power \(**\):", a ** b\) # 3200000) Tj
T* () Tj
T* (# Program 2: Even or Odd) Tj
T* (print\("\\n--- Program 2: Even or Odd ---"\)) Tj
T* (number = 42) Tj
T* (if number % 2 == 0:) Tj
T* (print\(f"{number} is Even"\)) Tj
T* (else:) Tj
T* (print\(f"{number} is Odd"\)) Tj
T* () Tj
T* (# Program 3: Largest of Two Numbers) Tj
T* (print\("\\n--- Program 3: Largest of Two ---"\)) Tj
T* (x = 50) Tj
T* (y = 75) Tj
T* (largest_two = x if x > y else y) Tj
T* (print\(f"Largest of {x} and {y}: {largest_two}"\)) Tj
T* () Tj
T* (# Program 4: Largest of Three Numbers) Tj
T* (print\("\\n--- Program 4: Largest of Three ---"\)) Tj
T* (n1, n2, n3 = 45, 89, 62) Tj
T* (if n1 >= n2 and n1 >= n3:) Tj
T* (largest_three = n1) Tj
T* (elif n2 >= n1 and n2 >= n3:) Tj
T* (largest_three = n2) Tj
T* (else:) Tj
T* (largest_three = n3) Tj
T* (print\(f"Largest of {n1}, {n2}, {n3}: {largest_three}"\)) Tj
T* () Tj
T* (# Program 5: Student Eligibility Checker) Tj
T* (print\("\\n--- Program 5: Eligibility Checker ---"\)) Tj
T* (age = 22) Tj
T* (marks = 75) Tj
T* (if age >= 18 and marks >= 60:) Tj
T* (print\("Eligible for Admission"\)) Tj
T* (else:) Tj
T* (print\("Not eligible"\)) Tj
T* () Tj
T* (# Program 6: Simple Discount Calculator) Tj
T* (print\("\\n--- Program 6: Discount Calculator ---"\)) Tj
T* (price = 2000.0) Tj
T* (discount_percent = 10.0) Tj
T* (discount_amount = price * discount_percent / 100) Tj
T* (final_price = price - discount_amount) Tj
T* (print\("Original Price:", price\)) Tj
T* (print\("Discount Amount:", discount_amount\)) Tj
T* (print\("Final Price:", final_price\)) Tj
