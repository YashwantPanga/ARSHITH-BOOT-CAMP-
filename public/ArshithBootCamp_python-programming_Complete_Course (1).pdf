(import traceback) Tj
T* (import sys) Tj
T* () Tj
T* (def level_three\(\):) Tj
T* (data = [10, 20, 30]) Tj
T* (return data[10] # Raises IndexError) Tj
T* () Tj
T* (def level_two\(\):) Tj
T* (return level_three\(\)) Tj
T* () Tj
T* (def level_one\(\):) Tj
T* (return level_two\(\)) Tj
T* () Tj
T* (try:) Tj
T* (level_one\(\)) Tj
T* (except IndexError:) Tj
T* (# Capture formatted traceback as string without crashing) Tj
T* (tb_string = traceback.format_exc\(\)) Tj
T* (print\("Caught Exception Traceback Forensics:"\)) Tj
T* (print\("=" * 60\)) Tj
T* (print\(tb_string.strip\(\)\)) Tj
T* (print\("=" * 60\)) Tj
T* () Tj
T* (# Inspect exception info tuple) Tj
T* (exc_type, exc_val, exc_tb = sys.exc_info\(\)) Tj
T* (print\(f"Error Type: {exc_type.__name__}"\)) Tj
T* (print\(f"Error Desc: {exc_val}"\)) Tj
T* (print\(f"Origin Line: {exc_tb.tb_next.tb_next.tb_next.tb_lineno}"\)) Tj
