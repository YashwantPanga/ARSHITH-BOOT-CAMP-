(from collections import Counter, defaultdict, deque) Tj
T* () Tj
T* (# Program 1: Word Frequency Histogram & Top-K) Tj
T* (text = "data structures in python include lists dictionaries and tuples lists are mutable tuples) Tj
T* (are immutable") Tj
T* (words = text.split\(\)) Tj
T* (counts = Counter\(words\)) Tj
T* (print\("--- Program 1: Top 3 Words ---"\)) Tj
T* (print\(counts.most_common\(3\)\)) Tj
T* () Tj
T* (# Program 2: 2D Grid Transposition) Tj
T* (matrix = [) Tj
T* ([1, 2, 3],) Tj
T* ([4, 5, 6],) Tj
T* ([7, 8, 9]) Tj
T* (]) Tj
T* (transposed = [[row[i] for row in matrix] for i in range\(len\(matrix[0]\)\)]) Tj
T* (print\("\\n--- Program 2: Matrix Transpose ---"\)) Tj
T* (for r in transposed:) Tj
T* (print\(r\)) Tj
T* () Tj
T* (# Program 3: Dictionary Inverter) Tj
T* (grades = {"Asha": "A", "Ben": "B", "Chloe": "A", "David": "B", "Elena": "A+"}) Tj
T* (inverted = {}) Tj
T* (for name, grade in grades.items\(\):) Tj
T* (inverted.setdefault\(grade, []\).append\(name\)) Tj
T* (print\("\\n--- Program 3: Inverted Gradebook ---", inverted\)) Tj
T* () Tj
T* (# Program 4: DSU Multi-Field Sorter) Tj
T* (words_list = ["banana", "pie", "apple", "fig", "kiwi", "date"]) Tj
T* (# Decorate: \(length, word.lower\(\), word\)) Tj
T* (decorated = [\(len\(w\), w.lower\(\), w\) for w in words_list]) Tj
T* (decorated.sort\(\)) Tj
T* (sorted_words = [w for length, low, w in decorated]) Tj
T* (print\("\\n--- Program 4: DSU Sorted Words ---", sorted_words\)) Tj
T* () Tj
T* (# Program 5: Configuration Merger \(|\)) Tj
T* (defaults = {"theme": "dark", "fontSize": 14, "autoSave": True, "showLineNumbers": True}) Tj
T* (user_settings = {"fontSize": 16, "autoSave": False, "theme": "cyberpunk"}) Tj
T* (active_config = defaults | user_settings) Tj
T* (print\("\\n--- Program 5: Merged Config ---", active_config\)) Tj
T* () Tj
T* (# Program 6: Sales Grouping with setdefault) Tj
T* (transactions = [) Tj
T* (\("Electronics", 299.99\),) Tj
T* (\("Books", 15.50\),) Tj
T* (\("Electronics", 89.00\),) Tj
T* (\("Groceries", 45.20\),) Tj
T* (\("Books", 22.00\)) Tj
T* (]) Tj
T* (category_totals = {}) Tj
T* (for category, amount in transactions:) Tj
T* (category_totals[category] = category_totals.get\(category, 0.0\) + amount) Tj
T* () Tj
T* (print\("\\n--- Program 6: Sales Totals by Category ---"\)) Tj
T* (for cat, total in sorted\(category_totals.items\(\)\):) Tj
T* (print\(f"{cat}: $" + f"{total:.2f}"\)) Tj
T* () Tj
T* (# Program 7: Role-Based Access Control \(RBAC\) with Sets) Tj
T* (required_permissions = {"read", "write", "delete", "export"}) Tj
T* (user_permissions = {"read", "write", "audit"}) Tj
T* () Tj
T* (missing_permissions = required_permissions - user_permissions) Tj
T* (has_access = required_permissions.issubset\(user_permissions\)) Tj
T* (print\("\\n--- Program 7: RBAC Access Check ---"\)) Tj
T* (print\(f"User Permissions: {user_permissions}"\)) Tj
T* (print\(f"Missing Required: {missing_permissions}"\)) Tj
T* (print\(f"Access Granted: {has_access}"\)) Tj
T* () Tj
T* (# Program 8: Sliding Window Rate Limiter with deque) Tj
T* (class RateLimiter:) Tj
T* (def __init__\(self, max_requests=3, window_seconds=10\):) Tj
T* (self.max_requests = max_requests) Tj
T* (self.window_seconds = window_seconds) Tj
T* (self.requests = deque\(\)) Tj
T* () Tj
T* (def allow_request\(self, current_time\):) Tj
T* (while self.requests and \(current_time - self.requests[0]\) > self.window_seconds:) Tj
T* (self.requests.popleft\(\)) Tj
T* (if len\(self.requests\) < self.max_requests:) Tj
T* (self.requests.append\(current_time\)) Tj
T* (return True) Tj
T* (return False) Tj
T* () Tj
T* (limiter = RateLimiter\(max_requests=3, window_seconds=10\)) Tj
T* (test_timestamps = [1, 3, 5, 8, 12, 15]) Tj
T* (print\("\\n--- Program 8: Rate Limiter History ---"\)) Tj
T* (for ts in test_timestamps:) Tj
T* (allowed = limiter.allow_request\(ts\)) Tj
T* (print\(f"Timestamp {ts}s: {'Allowed' if allowed else 'Blocked \(429 Rate Limit\)'}"\)) Tj
ET
endstream
