(import io) Tj
T* (import re) Tj
T* (import socket) Tj
T* (import urllib.request) Tj
T* (import urllib.error) Tj
T* (from bs4 import BeautifulSoup) Tj
T* (from collections import Counter) Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 1: Low-Level HTTP Protocol Inspector) Tj
T* (# ==============================================================================) Tj
T* (def inspect_http_headers_via_socket\(host, path, port=80\):) Tj
T* (s = socket.socket\(socket.AF_INET, socket.SOCK_STREAM\)) Tj
T* (s.connect\(\(host, port\)\)) Tj
T* () Tj
T* (cmd = f"GET {path} HTTP/1.1) Tj
T* (Host: {host}) Tj
T* (Connection: close) Tj
T* () Tj
T* (") Tj
T* (s.sendall\(cmd.encode\('utf-8'\)\)) Tj
T* () Tj
T* (response = "") Tj
T* (while True:) Tj
T* (data = s.recv\(512\)) Tj
T* (if len\(data\) < 1: break) Tj
T* (response += data.decode\('utf-8'\)) Tj
T* (s.close\(\)) Tj
T* () Tj
T* (header_part, body_part = response.split\(') Tj
T* () Tj
T* (', 1\)) Tj
T* (header_lines = header_part.split\(') Tj
T* ('\)) Tj
T* (status_line = header_lines[0]) Tj
T* () Tj
T* (headers_dict = {}) Tj
T* (for line in header_lines[1:]:) Tj
T* (if ":" in line:) Tj
T* (k, v = line.split\(":", 1\)) Tj
T* (headers_dict[k.strip\(\)] = v.strip\(\)) Tj
T* () Tj
T* (return status_line, headers_dict, len\(body_part\)) Tj
T* () Tj
T* (status, headers, body_len = inspect_http_headers_via_socket\("data.pr4e.org",) Tj
T* ("/code3/intro-short.txt"\)) Tj
T* (print\("Challenge 1 - Low-Level Socket Headers:"\)) Tj
T* (print\(f" Status Line: {status}"\)) Tj
T* (print\(f" Content-Type: {headers.get\('Content-Type'\)}"\)) Tj
T* (print\(f" Body Size: {body_len} bytes"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 2: Web Page Word Frequency Counter) Tj
T* (# ==============================================================================) Tj
T* (def analyze_web_word_frequency\(url, min_len=4\):) Tj
T* (counts = Counter\(\)) Tj
T* (with urllib.request.urlopen\(url\) as resp:) Tj
T* (for line in resp:) Tj
T* (words = line.decode\('utf-8'\).lower\(\).split\(\)) Tj
T* (for w in words:) Tj
T* (clean_word = re.sub\(r'[^a-z]', '', w\)) Tj
T* (if len\(clean_word\) >= min_len:) Tj
T* (counts[clean_word] += 1) Tj
T* (return counts) Tj
T* () Tj
T* (web_counts = analyze_web_word_frequency\("http://data.pr4e.org/romeo.txt", min_len=4\)) Tj
T* (print\(") Tj
T* (Challenge 2 - Web Word Frequency \(>= 4 chars\):"\)) Tj
T* (for word, cnt in web_counts.most_common\(5\):) Tj
T* (print\(f" - {word:<12}: {cnt} occurrences"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 3: HTML Table Scraper to Dictionary Records) Tj
T* (# ==============================================================================) Tj
T* (sample_table_html = """) Tj
T* (<table id="grades">) Tj
T* (<tr><th>Student</th><th>Subject</th><th>Score</th></tr>) Tj
T* (<tr><td>Ananya</td><td>Python</td><td>96</td></tr>) Tj
T* (<tr><td>Rahul</td><td>SQL</td><td>88</td></tr>) Tj
T* (<tr><td>Priya</td><td>Networking</td><td>92</td></tr>) Tj
T* (</table>""") Tj
T* () Tj
T* (def scrape_table_to_dicts\(html_str\):) Tj
T* (soup = BeautifulSoup\(html_str, 'html.parser'\)) Tj
T* (table = soup.find\('table'\)) Tj
T* (headers = [th.text.strip\(\) for th in table.find_all\('th'\)]) Tj
T* () Tj
T* (records = []) Tj
T* (for row in table.find_all\('tr'\)[1:]:) Tj
T* (cells = [td.text.strip\(\) for td in row.find_all\('td'\)]) Tj
T* (if cells:) Tj
T* (records.append\(dict\(zip\(headers, cells\)\)\)) Tj
T* (return records) Tj
T* () Tj
T* (students_data = scrape_table_to_dicts\(sample_table_html\)) Tj
T* (print\(") Tj
T* (Challenge 3 - Scraped HTML Table:"\)) Tj
T* (for s in students_data:) Tj
T* (print\(f" Student: {s['Student']:<10} | Subject: {s['Subject']:<12} | Score: {s['Score']}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 4: Hyperlink Trail Follower \(Spider Crawler Simulation\)) Tj
T* (# ==============================================================================) Tj
T* (sample_pages = {) Tj
T* ("start.html": '<a href="page2.html">Next 1</a> <a href="page3.html">Next 2</a>',) Tj
T* ("page3.html": '<a href="page4.html">Target</a> <a href="final.html">Winner</a>',) Tj
T* ("final.html": '<h1>Destination Reached!</h1>') Tj
T* (}) Tj
T* () Tj
T* (def crawl_link_sequence\(start_key, link_index, hops\):) Tj
T* (current = start_key) Tj
T* (trail = [current]) Tj
T* () Tj
T* (for _ in range\(hops\):) Tj
T* (html = sample_pages.get\(current, ""\)) Tj
T* (soup = BeautifulSoup\(html, 'html.parser'\)) Tj
T* (links = [a.get\('href'\) for a in soup.find_all\('a'\)]) Tj
T* (if len\(links\) > link_index:) Tj
T* (current = links[link_index]) Tj
T* (trail.append\(current\)) Tj
T* (else:) Tj
T* (break) Tj
T* (return trail) Tj
T* () Tj
T* (path_taken = crawl_link_sequence\("start.html", 1, 2\)) Tj
T* (print\(") Tj
T* (Challenge 4 - Hyperlink Spider Trail:"\)) Tj
T* (print\(f" Crawl Trail: {' -> '.join\(path_taken\)}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 5: Robust URL Fetcher with Error Handling) Tj
T* (# ==============================================================================) Tj
T* (def safe_fetch_url\(url, timeout=3\):) Tj
T* (req = urllib.request.Request\(url, headers={'User-Agent': 'BootcampBot/1.0'}\)) Tj
T* (try:) Tj
T* (with urllib.request.urlopen\(req, timeout=timeout\) as response:) Tj
T* (return response.status, response.read\(60\).decode\('utf-8'\)) Tj
T* (except urllib.error.HTTPError as e:) Tj
T* (return e.code, f"HTTP Error: {e.reason}") Tj
T* (except urllib.error.URLError as e:) Tj
T* (return 0, f"URL Error: {e.reason}") Tj
T* () Tj
T* (status_code, preview = safe_fetch_url\("http://data.pr4e.org/romeo.txt"\)) Tj
T* (print\(f") Tj
T* (Challenge 5 - Safe URL Fetch Status: HTTP {status_code}"\)) Tj
T* (print\(f" Preview: {preview.strip\(\)}..."\)) Tj
ET
