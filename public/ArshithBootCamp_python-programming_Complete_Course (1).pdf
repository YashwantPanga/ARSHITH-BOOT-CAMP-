(import os) Tj
T* (from pathlib import Path) Tj
T* () Tj
T* (def safe_atomic_write\(target_path, content\):) Tj
T* (path = Path\(target_path\)) Tj
T* (temp_path = path.with_suffix\(".tmp"\)) Tj
T* () Tj
T* (try:) Tj
T* (# Step 1: Write all content to temporary swap file) Tj
T* (with open\(temp_path, mode="w", encoding="utf-8"\) as f:) Tj
T* (f.write\(content\)) Tj
T* (f.flush\(\)) Tj
T* (os.fsync\(f.fileno\(\)\) # Force hardware write) Tj
T* () Tj
T* (# Step 2: Atomic rename \(replaces target atomically\)) Tj
T* (temp_path.replace\(path\)) Tj
T* (print\(f"Atomic update succeeded for: {path.name}"\)) Tj
T* (return True) Tj
T* (except Exception as e:) Tj
T* (# Step 3: Cleanup temporary file if write failed) Tj
T* (if temp_path.exists\(\):) Tj
T* (temp_path.unlink\(\)) Tj
T* (print\(f"Atomic update aborted due to: {e}"\)) Tj
T* (return False) Tj
T* () Tj
T* (# Demonstrate atomic write) Tj
T* (safe_atomic_write\("production_config.txt", "SERVER_HOST=127.0.0.1) Tj
T* (SERVER_PORT=8080) Tj
T* (DEBUG=False) Tj
T* ("\)) Tj
