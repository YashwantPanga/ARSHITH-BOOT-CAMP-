T* (print\("list_a is list_b \(Object identity\):", list_a is list_b\) # False \(different memory) Tj
T* (addresses\)) Tj
T* (print\("list_a is list_c \(Same object\):", list_a is list_c\) # True) Tj
T* () Tj
