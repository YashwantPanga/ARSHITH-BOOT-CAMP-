(data = [-8, -3, -12, -5]) Tj
T* (if data:) Tj
T* (smallest = data[0]) Tj
T* (largest = data[0]) Tj
T* (for val in data[1:]:) Tj
T* (if val < smallest: smallest = val) Tj
T* (if val > largest: largest = val) Tj
T* (print\(f"Smallest: {smallest}, Largest: {largest}"\)) Tj
T* () Tj
T* (# enumerate\(\) for index and item) Tj
T* (fruits = ["apple", "banana", "mango"]) Tj
T* (for idx, fruit in enumerate\(fruits, start=1\):) Tj
T* (print\(f"{idx}. {fruit}"\)) Tj
T* () Tj
T* (# Nested loops \(grid coordinates\)) Tj
T* (for r in range\(1, 3\):) Tj
T* (for c in range\(1, 4\):) Tj
T* (print\(f"\({r}, {c}\)", end=" "\)) Tj
T* (print\(\)) Tj
T* () Tj
T* (# Loop else clause \(runs only if NO break occurred\)) Tj
T* (test_numbers = [2, 4, 6]) Tj
T* (for num in test_numbers:) Tj
T* (if num % 2 != 0:) Tj
T* (print\("Odd found!"\)) Tj
T* (break) Tj
T* (else:) Tj
T* (print\("No odd numbers found \(normal completion\)."\)) Tj
