(from collections import defaultdict, deque) Tj
T* () Tj
T* (# 1. defaultdict: Automatic list initialization) Tj
T* (departments = defaultdict\(list\)) Tj
T* (departments["Engineering"].append\("Asha"\)) Tj
T* (departments["Engineering"].append\("Ben"\)) Tj
T* (departments["Design"].append\("Chloe"\)) Tj
T* (print\("Departments:", dict\(departments\)\)) Tj
T* () Tj
T* (# 2. deque: O\(1\) front and rear operations) Tj
T* (recent_actions = deque\(maxlen=3\)) Tj
T* (for action in ["login", "view_course", "take_quiz", "logout"]:) Tj
T* (recent_actions.append\(action\)) Tj
T* (print\("Action history:", list\(recent_actions\)\)) Tj
ET
