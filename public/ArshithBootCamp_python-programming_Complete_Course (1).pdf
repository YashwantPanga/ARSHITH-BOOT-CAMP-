(log_data = """From: stephen.marquard@uct.ac.za Sat Jan 5 09:14:16 2008) Tj
T* (Return-Path: <postmaster@collab.sakaiproject.org>) Tj
T* (From: louis@media.berkeley.edu Fri Jan 4 18:10:48 2008) Tj
T* (Subject: [sakai] svn commit: r39772) Tj
T* (From: zqian@umich.edu Fri Jan 4 16:10:39 2008) Tj
T* (From: rjlowe@iupui.edu Fri Jan 4 15:46:24 2008""") Tj
T* () Tj
T* (import io) Tj
T* () Tj
T* (# Simulate a server log file using an in-memory stream) Tj
T* (log_stream = io.StringIO\(log_data\)) Tj
T* () Tj
T* (sender_count = 0) Tj
T* (unique_domains = set\(\)) Tj
T* () Tj
T* (for line in log_stream:) Tj
T* (line = line.rstrip\(\)) Tj
T* (# Fast guard clause: skip uninteresting lines immediately) Tj
T* (if not line.startswith\("From:"\):) Tj
T* (continue) Tj
T* () Tj
T* (# Extract sender email address) Tj
T* (parts = line.split\(\)) Tj
T* (email = parts[1]) Tj
T* (sender_count += 1) Tj
T* () Tj
T* (# Extract domain name using find/slice) Tj
T* (at_idx = email.find\("@"\)) Tj
T* (domain = email[at_idx + 1:]) Tj
T* (unique_domains.add\(domain\)) Tj
T* (print\(f"Sender #{sender_count}: {email} \(Domain: {domain}\)"\)) Tj
T* () Tj
T* (print\(f") Tj
T* (Total Senders: {sender_count}"\)) Tj
T* (print\(f"Unique Domains \({len\(unique_domains\)}\): {sorted\(unique_domains\)}"\)) Tj
ET
