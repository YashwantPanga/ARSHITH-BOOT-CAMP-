(audit_log = "application_audit.log") Tj
T* () Tj
T* (# Step 1: Write header and initial entries \(mode 'w' creates/overwrites\)) Tj
T* (with open\(audit_log, mode="w", encoding="utf-8"\) as f:) Tj
T* (f.write\("TIMESTAMP | SEVERITY | EVENT_DESCRIPTION) Tj
T* ("\)) Tj
T* (f.write\("2026-10-03T12:00:00Z | INFO | System boot initialized) Tj
T* ("\)) Tj
T* (f.write\("2026-10-03T12:00:02Z | INFO | Database connection verified) Tj
T* ("\)) Tj
T* () Tj
T* (# Step 2: Append new event without overwriting existing data \(mode 'a'\)) Tj
T* (with open\(audit_log, mode="a", encoding="utf-8"\) as f:) Tj
T* (f.write\("2026-10-03T12:00:05Z | WARN | High CPU load detected on node 4) Tj
T* ("\)) Tj
T* (f.write\("2026-10-03T12:00:09Z | INFO | Memory garbage collection triggered) Tj
T* ("\)) Tj
T* () Tj
T* (# Step 3: Verify results by reading) Tj
T* (with open\(audit_log, mode="r", encoding="utf-8"\) as f:) Tj
T* (print\(f.read\(\)\)) Tj
ET
