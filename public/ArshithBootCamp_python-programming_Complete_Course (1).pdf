(header = "From: stephen.marquard@uct.ac.za Sat Jan 5 09:14:16 2008") Tj
T* () Tj
T* (# Step 1: Find '@' position) Tj
T* (at_pos = header.find\("@"\)) Tj
T* () Tj
T* (# Step 2: Find the space following the '@') Tj
T* (space_pos = header.find\(" ", at_pos\)) Tj
T* () Tj
T* (# Step 3: Slice the domain host) Tj
T* (host = header[at_pos + 1 : space_pos]) Tj
T* (print\("Extracted Host Domain:", host\)) Tj
T* () Tj
T* (# Alternative Token-Based Approach) Tj
T* (parts = header.split\(\)) Tj
T* (email_address = parts[1]) Tj
T* (domain_name = email_address.split\("@"\)[1]) Tj
T* (print\("Token-Parsed Domain:", domain_name\)) Tj
ET
