(class OrderProcessingError\(Exception\):) Tj
T* ("""Base exception for e-commerce order processing.""") Tj
T* (pass) Tj
T* () Tj
T* (class OutOfStockError\(OrderProcessingError\):) Tj
T* (def __init__\(self, item_id, requested_qty, available_qty\):) Tj
T* (message = f"Item '{item_id}' out of stock: requested {requested_qty}, available {available_qty}") Tj
T* (super\(\).__init__\(message\)) Tj
T* (self.item_id = item_id) Tj
T* (self.requested_qty = requested_qty) Tj
T* (self.available_qty = available_qty) Tj
T* () Tj
T* (class InvalidPaymentError\(OrderProcessingError\):) Tj
T* (def __init__\(self, payment_method, reason\):) Tj
T* (super\(\).__init__\(f"Payment failed via {payment_method}: {reason}"\)) Tj
T* (self.payment_method = payment_method) Tj
T* () Tj
T* (def checkout\(inventory, item_id, qty\):) Tj
T* (if item_id not in inventory:) Tj
T* (raise OrderProcessingError\(f"Unrecognized catalog item: {item_id}"\)) Tj
T* (if inventory[item_id] < qty:) Tj
T* (raise OutOfStockError\(item_id, qty, inventory[item_id]\)) Tj
T* () Tj
T* (inventory[item_id] -= qty) Tj
T* (print\(f"Order confirmed! {qty}x {item_id} purchased."\)) Tj
T* () Tj
T* (stock = {"LAPTOP-01": 3, "MOUSE-05": 10}) Tj
T* () Tj
T* (try:) Tj
T* (checkout\(stock, "LAPTOP-01", 5\)) Tj
T* (except OutOfStockError as stock_err:) Tj
T* (print\(f"Inventory Alert: {stock_err}"\)) Tj
T* (print\(f"Remaining units: {stock_err.available_qty}"\)) Tj
T* (except OrderProcessingError as gen_err:) Tj
T* (print\(f"General Order Failure: {gen_err}"\)) Tj
ET
