(mbox_sample = """From: source@collab.sakaiproject.org) Tj
T* (X-DSPAM-Confidence: 0.8475) Tj
T* (X-DSPAM-Probability: 0.0000) Tj
T* (From: source@collab.sakaiproject.org) Tj
T* (X-DSPAM-Confidence: 0.6178) Tj
T* (From: source@collab.sakaiproject.org) Tj
T* (X-DSPAM-Confidence: 0.6961) Tj
T* (From: source@collab.sakaiproject.org) Tj
T* (X-DSPAM-Confidence: 0.7565""") Tj
T* () Tj
T* (import io) Tj
T* () Tj
T* (stream = io.StringIO\(mbox_sample\)) Tj
T* () Tj
T* (confidence_total = 0.0) Tj
T* (record_count = 0) Tj
T* () Tj
T* (for line in stream:) Tj
T* (line = line.rstrip\(\)) Tj
T* (if line.startswith\("X-DSPAM-Confidence:"\):) Tj
T* (# Extract number following colon) Tj
T* (_, value_str = line.split\(":"\)) Tj
T* (confidence_val = float\(value_str.strip\(\)\)) Tj
T* () Tj
T* (confidence_total += confidence_val) Tj
T* (record_count += 1) Tj
T* () Tj
T* (if record_count > 0:) Tj
T* (avg_confidence = confidence_total / record_count) Tj
T* (print\(f"Processed Records: {record_count}"\)) Tj
T* (print\(f"Total Sum: {confidence_total:.4f}"\)) Tj
T* (print\(f"Average Spam Confidence: {avg_confidence:.6f}"\)) Tj
T* (else:) Tj
T* (print\("No valid spam confidence records discovered."\)) Tj
