(import csv) Tj
T* (import io) Tj
T* () Tj
T* (raw_csv = """EmployeeID,Name,Department,Salary,Rating) Tj
T* (E101,"Sharma, Ananya",Engineering,95000,4.9) Tj
T* (E102,"Kumar, Rahul",Analytics,82000,4.7) Tj
T* (E103,"Verma, Priya",Engineering,105000,4.95) Tj
T* (E104,"Joseph, John",Marketing,71000,4.2""") Tj
T* () Tj
T* (# Read with DictReader) Tj
T* (csv_stream = io.StringIO\(raw_csv\)) Tj
T* (reader = csv.DictReader\(csv_stream\)) Tj
T* () Tj
T* (dept_totals = {}) Tj
T* (dept_counts = {}) Tj
T* () Tj
T* (print\(f"{'Name':<20} | {'Department':<14} | {'Salary':>10}"\)) Tj
T* (print\("-" * 50\)) Tj
T* () Tj
T* (for row in reader:) Tj
T* (name = row['Name']) Tj
T* (dept = row['Department']) Tj
T* (salary = float\(row['Salary']\)) Tj
T* () Tj
T* (print\(f"{name:<20} | {dept:<14} | " + f"{salary:>10.2f}"\)) Tj
T* () Tj
T* (dept_totals[dept] = dept_totals.get\(dept, 0.0\) + salary) Tj
T* (dept_counts[dept] = dept_counts.get\(dept, 0\) + 1) Tj
T* () Tj
T* (print\(") Tj
T* (--- Department Averages ---"\)) Tj
T* (for dept, total in dept_totals.items\(\):) Tj
T* (avg = total / dept_counts[dept]) Tj
T* (print\(f"{dept:<14}: " + f"{avg:>10.2f} \(Employees: {dept_counts[dept]}\)"\)) Tj
ET
