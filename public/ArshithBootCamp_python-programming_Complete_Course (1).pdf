T* (print\("Login successful"\)) Tj
T* (else:) Tj
T* (print\("Incorrect username or password"\)) Tj
T* () Tj
T* (# Exercise 4: Age Category Classifier) Tj
T* (try:) Tj
T* (age = int\(input\("Enter your age: "\)\)) Tj
T* (if age < 0:) Tj
T* (print\("Age cannot be negative."\)) Tj
T* (elif age < 13:) Tj
T* (print\("Child"\)) Tj
T* (elif age < 18:) Tj
T* (print\("Teenager"\)) Tj
T* (elif age < 65:) Tj
T* (print\("Adult"\)) Tj
T* (else:) Tj
T* (print\("Senior"\)) Tj
T* (except ValueError:) Tj
T* (print\("Please enter your age as a whole number."\)) Tj
T* () Tj
T* (# Exercise 5: Simple Calculator) Tj
T* (try:) Tj
T* (first = float\(input\("First number: "\)\)) Tj
T* (operator = input\("Operator \(+, -, *, /\): "\)) Tj
T* (second = float\(input\("Second number: "\)\)) Tj
T* () Tj
T* (if operator == "+":) Tj
T* (result = first + second) Tj
T* (print\("Result:", result\)) Tj
T* (elif operator == "-":) Tj
T* (result = first - second) Tj
T* (print\("Result:", result\)) Tj
T* (elif operator == "*":) Tj
T* (result = first * second) Tj
