(class Employee:) Tj
T* (def __init__\(self, emp_id, name, base_salary\):) Tj
T* (self.emp_id = emp_id) Tj
T* (self.name = name) Tj
T* (self.base_salary = base_salary) Tj
T* () Tj
T* (def calculate_annual_compensation\(self\):) Tj
T* (return self.base_salary) Tj
T* () Tj
T* (def __str__\(self\):) Tj
T* (return f"[{self.emp_id}] {self.name} \(Base: $" + f"{self.base_salary:,.2f}\)") Tj
T* () Tj
T* (class SoftwareEngineer\(Employee\):) Tj
T* (def __init__\(self, emp_id, name, base_salary, stock_options, tech_stack\):) Tj
T* (super\(\).__init__\(emp_id, name, base_salary\) # Delegate to parent) Tj
T* (self.stock_options = stock_options) Tj
T* (self.tech_stack = tech_stack) Tj
T* () Tj
T* (def calculate_annual_compensation\(self\):) Tj
T* (# Override parent method and add stock equity value) Tj
T* (return self.base_salary + \(self.stock_options * 25.0\)) Tj
T* () Tj
T* (dev = SoftwareEngineer\("DEV-402", "Bhavana", 95000, 1000, ["Python", "SQLite", "FastAPI"]\)) Tj
T* (print\(dev\)) Tj
T* (print\(f"Total Annual Compensation: $" + f"{dev.calculate_annual_compensation\(\):,.2f}"\)) Tj
T* (print\(f"Specialized Tech Stack: {', '.join\(dev.tech_stack\)}"\)) Tj
