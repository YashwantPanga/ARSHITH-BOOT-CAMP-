(class PDFReportExporter:) Tj
T* (def export\(self, title, data\):) Tj
T* (return f"[PDF Rendered]: '{title}' formatted into 2-column vector document \({len\(data\)} items\).") Tj
T* () Tj
T* (class CSVReportExporter:) Tj
T* (def export\(self, title, data\):) Tj
T* (return f"[CSV Exported]: '{title}.csv' generated with comma-delimited columns.") Tj
T* () Tj
T* (class JSONReportExporter:) Tj
T* (def export\(self, title, data\):) Tj
T* (return f"[JSON Serialized]: '{title}.json' encoded with UTF-8 payload.") Tj
T* () Tj
T* (def generate_business_summary\(exporter, report_title, dataset\):) Tj
T* (# Polymorphic call: exporter can be ANY class with an export\(\) method) Tj
T* (output = exporter.export\(report_title, dataset\)) Tj
T* (print\(output\)) Tj
T* () Tj
T* (telemetry = [89.4, 92.1, 95.7, 88.2]) Tj
T* (exporters = [PDFReportExporter\(\), CSVReportExporter\(\), JSONReportExporter\(\)]) Tj
T* () Tj
T* (for exp in exporters:) Tj
T* (generate_business_summary\(exp, "Monthly_Telemetry_Report", telemetry\)) Tj
