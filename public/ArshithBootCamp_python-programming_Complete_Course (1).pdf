(import json) Tj
T* () Tj
T* (class DatabaseConfigError\(Exception\):) Tj
T* ("""Raised when database settings are corrupted or unreadable.""") Tj
T* (pass) Tj
T* () Tj
T* (def load_database_credentials\(raw_json_str\):) Tj
T* (try:) Tj
T* (data = json.loads\(raw_json_str\)) Tj
T* (host = data['db_host']) Tj
T* (port = int\(data['db_port']\)) Tj
T* (return {"host": host, "port": port}) Tj
T* (except json.JSONDecodeError as json_err:) Tj
T* (# Chain original error to preserve root cause) Tj
T* (raise DatabaseConfigError\("Configuration syntax is malformed"\) from json_err) Tj
T* (except KeyError as key_err:) Tj
T* (raise DatabaseConfigError\(f"Missing mandatory configuration parameter: {key_err}"\) from key_err) Tj
T* () Tj
T* (# Test with invalid JSON syntax) Tj
T* (try:) Tj
T* (load_database_credentials\("HOST=localhost,PORT=5432"\)) Tj
T* (except DatabaseConfigError as cfg_err:) Tj
T* (print\(f"High-Level Error: {cfg_err}"\)) Tj
T* (print\(f"Root Cause Error: {cfg_err.__cause__}"\)) Tj
