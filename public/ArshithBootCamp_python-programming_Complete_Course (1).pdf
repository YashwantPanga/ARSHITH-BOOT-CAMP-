(import re) Tj
T* (from collections import Counter) Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 1: Strict Email Validator & Component Extractor) Tj
T* (# ==============================================================================) Tj
T* (EMAIL_STRICT =) Tj
T* (re.compile\(r'^\(?P<user>[a-zA-Z0-9_.+-]+\)@\(?P<domain>[a-zA-Z0-9-]+.\(?P<tld>[a-zA-Z]{2,}\)\)$'\)) Tj
T* () Tj
T* (def validate_and_parse_email\(email\):) Tj
T* (match = EMAIL_STRICT.fullmatch\(email.strip\(\)\)) Tj
T* (if match:) Tj
T* (return match.groupdict\(\)) Tj
T* (return None) Tj
T* () Tj
T* (test_emails = ["student@arshithbootcamp.com", "invalid-email@", "ananya.sharma@research.org",) Tj
T* ("bad@domain"]) Tj
T* (print\("Challenge 1 - Strict Email Parsing:"\)) Tj
T* (for e in test_emails:) Tj
T* (res = validate_and_parse_email\(e\)) Tj
T* (status = f"Valid: User='{res['user']}', Domain='{res['domain']}', TLD='{res['tld']}'" if res else) Tj
T* ("INVALID") Tj
T* (print\(f" {e:<32} -> {status}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 2: Comprehensive Phone Number Normalizer) Tj
T* (# ==============================================================================) Tj
T* (PHONE_PATTERN = re.compile\(r'^\(?:+?1[-.s]?\)?\(?\([2-9]d{2}\)\)?[-.s]?\(d{3}\)[-.s]?\(d{4}\)$'\)) Tj
T* () Tj
T* (def normalize_phone_number\(raw_phone\):) Tj
T* (match = PHONE_PATTERN.search\(raw_phone.strip\(\)\)) Tj
T* (if match:) Tj
T* (area, prefix, line = match.groups\(\)) Tj
T* (return f"\({area}\) {prefix}-{line}") Tj
T* (return None) Tj
T* () Tj
T* (samples = ["\(555\) 123-4567", "555.234.5678", "+1 555-345-6789", "5554567890", "123-bad-phone"]) Tj
T* (print\(") Tj
T* (Challenge 2 - Phone Normalization:"\)) Tj
T* (for s in samples:) Tj
T* (norm = normalize_phone_number\(s\)) Tj
T* (print\(f" {s:<20} -> {norm if norm else 'REJECTED'}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 3: Web Log IP and Status Aggregator) Tj
T* (# ==============================================================================) Tj
T* (sample_logs = """192.168.1.1 - [03/Oct/2026] "GET /index.html HTTP/1.1" 200 4500) Tj
T* (10.0.0.15 - [03/Oct/2026] "POST /api/login HTTP/1.1" 404 120) Tj
T* (172.16.0.4 - [03/Oct/2026] "GET /about HTTP/1.1" 200 3200) Tj
T* (192.168.1.1 - [03/Oct/2026] "GET /favicon.ico HTTP/1.1" 404 80""") Tj
T* () Tj
T* (LOG_REGEX = re.compile\(r'^\(?P<ip>S+\).+"\(?P<method>[A-Z]+\)s\(?P<path>S+\)s.+"s\(?P<status>d{3}\)'\)) Tj
T* () Tj
T* (status_counts = Counter\(\)) Tj
T* (for line in sample_logs.strip\(\).split\(') Tj
T* ('\):) Tj
T* (m = LOG_REGEX.search\(line\)) Tj
T* (if m:) Tj
T* (status_counts[m.group\('status'\)] += 1) Tj
T* () Tj
T* (print\(") Tj
T* (Challenge 3 - HTTP Status Distribution:"\)) Tj
T* (for status, cnt in status_counts.items\(\):) Tj
T* (print\(f" HTTP Status {status}: {cnt} requests"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 4: Markdown Link Extractor) Tj
T* (# ==============================================================================) Tj
T* (md_doc = """Explore our [Python Boot Camp]\(https://arshithbootcamp.com/python\) and check our) Tj
T* ([Official Documentation]\(https://docs.python.org/3/\) or read [Python for) Tj
T* (Everybody]\(https://py4e.com\).""") Tj
T* () Tj
T* (MD_LINK_REGEX = re.compile\(r'[\(?P<text>[^]]+\)]\(\(?P<url>https?://[^\)]+\)\)'\)) Tj
T* () Tj
T* (links = MD_LINK_REGEX.findall\(md_doc\)) Tj
T* (print\(") Tj
T* (Challenge 4 - Markdown Hyperlinks Extracted:"\)) Tj
T* (for text, url in links:) Tj
T* (print\(f" - Link Label: '{text}' -> URL: {url}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 5: Password Complexity Policy Validator) Tj
T* (# ==============================================================================) Tj
T* (def validate_password_security\(password\):) Tj
T* (if len\(password\) < 8: return False, "Must be at least 8 characters long.") Tj
T* (if not re.search\(r'[A-Z]', password\): return False, "Must contain at least 1 uppercase letter.") Tj
T* (if not re.search\(r'[a-z]', password\): return False, "Must contain at least 1 lowercase letter.") Tj
T* (if not re.search\(r'd', password\): return False, "Must contain at least 1 digit.") Tj
T* (if not re.search\(r'[@#$%^&*!_-]', password\): return False, "Must contain at least 1 special) Tj
T* (character \(@#$%^&*!_-\).") Tj
T* (return True, "Strong password verified.") Tj
T* () Tj
T* (passwords_to_test = ["weak", "Password123", "Arshith@2026", "alllowercase!1"]) Tj
T* (print\(") Tj
T* (Challenge 5 - Password Policy Validation:"\)) Tj
T* (for p in passwords_to_test:) Tj
T* (valid, reason = validate_password_security\(p\)) Tj
T* (print\(f" '{p}': {'PASS' if valid else 'FAIL'} \({reason}\)"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 6: Code Comment Stripper) Tj
T* (# ==============================================================================) Tj
T* (python_code = """x = 100 # Initialize x) Tj
T* (name = "Dr. Ananya # Lead Educator" # Name attribute) Tj
T* (total = x * 2 # Calculate total""") Tj
T* () Tj
T* (def strip_code_comments\(code_str\):) Tj
T* (cleaned_lines = []) Tj
T* (for line in code_str.split\(') Tj
T* ('\):) Tj
T* (# Match '#' that is not inside quotes) Tj
T* (parts = re.split\(r'\(?<!["']\)s*#.*$', line, maxsplit=1\)) Tj
T* (cleaned_lines.append\(parts[0]\)) Tj
T* (return ') Tj
T* ('.join\(cleaned_lines\)) Tj
T* () Tj
T* (clean_code = strip_code_comments\(python_code\)) Tj
T* (print\(") Tj
T* (Challenge 6 - Stripped Comments \(Preserving In-String '#' Symbols\):"\)) Tj
T* (print\(clean_code\)) Tj
ET
endstream
