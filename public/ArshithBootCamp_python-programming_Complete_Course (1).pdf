(import urllib.request) Tj
T* (from collections import Counter) Tj
T* () Tj
T* (target_url = "http://data.pr4e.org/romeo.txt") Tj
T* (word_counts = Counter\(\)) Tj
T* () Tj
T* (# Open URL as a streaming file handle) Tj
T* (with urllib.request.urlopen\(target_url\) as response:) Tj
T* (print\(f"HTTP Status: {response.status} {response.reason}"\)) Tj
T* (print\(f"Content Type: {response.headers.get_content_type\(\)}) Tj
T* ("\)) Tj
T* () Tj
T* (for line in response:) Tj
T* (# Decode byte stream to string) Tj
T* (clean_line = line.decode\('utf-8'\).strip\(\)) Tj
T* (words = clean_line.lower\(\).split\(\)) Tj
T* (word_counts.update\(words\)) Tj
T* () Tj
T* (print\("Top 5 Most Common Words in Romeo & Juliet Extract:"\)) Tj
T* (for word, count in word_counts.most_common\(5\):) Tj
T* (print\(f" - {word:<10}: {count} times"\)) Tj
