(import time) Tj
T* () Tj
T* (def resilient_operation_with_retry\(operation_func, max_retries=3, base_delay=0.1\):) Tj
T* (for attempt in range\(1, max_retries + 1\):) Tj
T* (try:) Tj
T* (return operation_func\(\)) Tj
T* (except ConnectionResetError as e:) Tj
T* (if attempt == max_retries:) Tj
T* (print\(f"Attempt {attempt}/{max_retries} failed permanently: {e}"\)) Tj
T* (raise) Tj
T* (delay = base_delay * \(2 ** \(attempt - 1\)\)) Tj
T* (print\(f"Attempt {attempt} failed \({e}\). Retrying in {delay:.2f}s..."\)) Tj
T* (time.sleep\(delay\)) Tj
T* () Tj
T* (# Simulate an unreliable network service) Tj
T* (call_count = 0) Tj
T* (def flaky_service\(\):) Tj
T* (global call_count) Tj
T* (call_count += 1) Tj
T* (if call_count < 3:) Tj
T* (raise ConnectionResetError\("Remote server dropped connection"\)) Tj
T* (return {"status": "SUCCESS", "records_synced": 42}) Tj
T* () Tj
T* (result = resilient_operation_with_retry\(flaky_service, max_retries=4\)) Tj
T* (print\(f"Resilient Call Result: {result}"\)) Tj
ET
