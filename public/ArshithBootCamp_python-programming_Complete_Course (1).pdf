(log_line = '192.168.1.45 - [03/Oct/2026:14:20:00 +0000] "GET /api/v1/courses/python HTTP/1.1" 200) Tj
T* (8452') Tj
T* () Tj
T* (import re) Tj
T* () Tj
T* (pattern = re.compile\(r''') Tj
T* (^\(?P<ip>d{1,3}\(?:.d{1,3}\){3}\) # IPv4 address) Tj
T* (s-s[\(?P<timestamp>[^]]+\)] # Timestamp between brackets) Tj
T* (s"\(?P<method>[A-Z]+\)s # HTTP Method \(GET, POST\)) Tj
T* (\(?P<endpoint>S+\)sHTTP/d.d" # URL Endpoint) Tj
T* (s\(?P<status>d{3}\) # HTTP Status Code) Tj
T* (s\(?P<bytes>d+\) # Transferred Bytes) Tj
T* (''', re.VERBOSE\)) Tj
T* () Tj
T* (match = pattern.search\(log_line\)) Tj
T* (if match:) Tj
T* (data = match.groupdict\(\)) Tj
T* (print\("Parsed Structured Log Record:"\)) Tj
T* (for k, v in data.items\(\):) Tj
T* (print\(f" {k:<12}: {v}"\)) Tj
