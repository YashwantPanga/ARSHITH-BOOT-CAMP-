(numbers = [4, 7, 10, 13, 16]) Tj
T* () Tj
T* (# 1. Counter Pattern) Tj
T* (even_count = 0) Tj
T* (for n in numbers:) Tj
T* (if n % 2 == 0:) Tj
T* (even_count += 1) Tj
T* (print\("Even numbers count:", even_count\)) Tj
T* () Tj
T* (# 2. Accumulator Pattern & Average) Tj
T* (scores = [80, 90, 100]) Tj
T* (total = 0) Tj
T* (for s in scores:) Tj
T* (total += s) Tj
T* () Tj
T* (if len\(scores\) > 0:) Tj
T* (avg = total / len\(scores\)) Tj
T* (print\(f"Total: {total}, Average: {avg}"\)) Tj
T* () Tj
T* (# 3. Search Pattern with Flag) Tj
T* (names = ["Asha", "Ben", "Chloe"]) Tj
T* (target = "Ben") Tj
T* (found = False) Tj
T* (for name in names:) Tj
T* (if name == target:) Tj
T* (found = True) Tj
T* (break) Tj
T* (print\("Target Found:" if found else "Target Not Found"\)) Tj
