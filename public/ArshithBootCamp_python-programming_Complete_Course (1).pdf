(import copy) Tj
T* () Tj
T* (# 1. Aliasing trap) Tj
T* (a = [[1, 2], [3, 4]]) Tj
T* (b = a) Tj
T* (b.append\([5, 6]\)) Tj
T* (print\("a after b.append:", len\(a\)\) # 3 \(affected!\)) Tj
T* () Tj
T* (# 2. Shallow copy vs Deep copy on nested lists) Tj
T* (shallow = a.copy\(\)) Tj
T* (deep = copy.deepcopy\(a\)) Tj
T* () Tj
T* (shallow[0][0] = 999) Tj
T* (print\("a[0][0] after shallow modification:", a[0][0]\) # 999 \(shared!\)) Tj
T* (print\("deep[0][0] after deepcopy untouched:", deep[0][0]\) # 1 \(safe!\)) Tj
