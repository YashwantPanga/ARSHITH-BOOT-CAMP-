(import sqlite3) Tj
T* () Tj
T* (# Connect to database file \(creates it if not existing\)) Tj
T* (conn = sqlite3.connect\('academy_demo.db'\)) Tj
T* (cur = conn.cursor\(\)) Tj
T* () Tj
T* (# Step 1: Create fresh schema) Tj
T* (cur.execute\('DROP TABLE IF EXISTS Student'\)) Tj
T* (cur.execute\(''') Tj
T* (CREATE TABLE Student \() Tj
T* (id INTEGER PRIMARY KEY AUTOINCREMENT,) Tj
T* (name TEXT NOT NULL,) Tj
T* (email TEXT UNIQUE NOT NULL,) Tj
T* (gpa REAL DEFAULT 0.0) Tj
T* (\)) Tj
T* ('''\)) Tj
T* () Tj
T* (# Step 2: Insert records using secure parameterized queries \(?\)) Tj
T* (students_data = [) Tj
T* (\("Dr. Ananya Sharma", "ananya@arshithbootcamp.com", 3.98\),) Tj
T* (\("Rahul Kumar", "rahul.k@technology.org", 3.82\),) Tj
T* (\("Priya Verma", "priya.v@analytics.edu", 3.91\)) Tj
T* (]) Tj
T* () Tj
T* (for name, email, gpa in students_data:) Tj
T* (cur.execute\(''') Tj
T* (INSERT INTO Student \(name, email, gpa\)) Tj
T* (VALUES \(?, ?, ?\)) Tj
T* (''', \(name, email, gpa\)\)) Tj
T* () Tj
T* (# Step 3: Commit changes permanently to disk) Tj
T* (conn.commit\(\)) Tj
T* () Tj
T* (# Step 4: Query records) Tj
T* (cur.execute\('SELECT id, name, gpa FROM Student WHERE gpa >= ? ORDER BY gpa DESC', \(3.90,\)\)) Tj
T* (print\("Honor Students \(GPA >= 3.90\):"\)) Tj
T* (for row in cur:) Tj
T* (print\(f" [ID #{row[0]}] {row[1]:<20} | GPA: {row[2]:.2f}"\)) Tj
T* () Tj
T* (cur.close\(\)) Tj
T* (conn.close\(\)) Tj
ET
