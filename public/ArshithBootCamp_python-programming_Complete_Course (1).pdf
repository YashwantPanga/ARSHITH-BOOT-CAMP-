(def calculate_employee_bonus\(salary, performance_score, years_tenure\):) Tj
T* (# Guard clauses with explicit exceptions) Tj
T* (if not isinstance\(salary, \(int, float\)\) or salary <= 0:) Tj
T* (raise TypeError\(f"Salary must be a positive number, got: {salary!r}"\)) Tj
T* (if not \(1.0 <= performance_score <= 5.0\):) Tj
T* (raise ValueError\(f"Performance score must be between 1.0 and 5.0, got: {performance_score}"\)) Tj
T* (if years_tenure < 0:) Tj
T* (raise ValueError\(f"Tenure cannot be negative, got: {years_tenure}"\)) Tj
T* () Tj
T* (# Business calculations) Tj
T* (multiplier = 0.05 if performance_score < 3.0 else 0.15) Tj
T* (tenure_bonus = years_tenure * 500.0) Tj
T* (total_bonus = \(salary * multiplier\) + tenure_bonus) Tj
T* (return total_bonus) Tj
T* () Tj
T* (print\(f"Senior Engineer Bonus: $" + f"{calculate_employee_bonus\(85000, 4.8, 6\):,.2f}"\)) Tj
T* () Tj
T* (try:) Tj
T* (calculate_employee_bonus\(-50000, 4.0, 2\)) Tj
T* (except \(TypeError, ValueError\) as err:) Tj
T* (print\(f"Defensive Guard Blocked: {err}"\)) Tj
ET
