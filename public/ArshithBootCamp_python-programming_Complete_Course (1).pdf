(import sys) Tj
T* () Tj
T* (# Tuple containing a mutable list) Tj
T* (record = \("ID101", ["physics", "math"]\)) Tj
T* (print\("Original record:", record\)) Tj
T* () Tj
T* (# Modifying the mutable inner list is ALLOWED!) Tj
T* (record[1].append\("chemistry"\)) Tj
T* (print\("Modified record:", record\)) Tj
T* () Tj
T* (# Memory comparison) Tj
T* (list_obj = [1, 2, 3, 4, 5]) Tj
T* (tuple_obj = \(1, 2, 3, 4, 5\)) Tj
T* (print\("List byte size:", sys.getsizeof\(list_obj\)\)) Tj
T* (print\("Tuple byte size:", sys.getsizeof\(tuple_obj\)\)) Tj
