T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 6: Library Catalog Management System) Tj
T* (# ==============================================================================) Tj
T* (class Book:) Tj
T* (def __init__\(self, isbn, title, author\):) Tj
T* (self.isbn = isbn) Tj
T* (self.title = title) Tj
T* (self.author = author) Tj
T* (self.is_checked_out = False) Tj
T* () Tj
T* (class LibraryCatalog:) Tj
T* (def __init__\(self\):) Tj
T* (self._books = {}) Tj
T* () Tj
T* (def add_book\(self, book\):) Tj
T* (self._books[book.isbn] = book) Tj
T* () Tj
T* (def __len__\(self\):) Tj
T* (return len\(self._books\)) Tj
T* () Tj
T* (def __getitem__\(self, isbn\):) Tj
T* (return self._books[isbn]) Tj
T* () Tj
T* (catalog = LibraryCatalog\(\)) Tj
T* (catalog.add_book\(Book\("978-01", "Python for Everybody", "Dr. Charles Severance"\)\)) Tj
T* (catalog.add_book\(Book\("978-02", "Clean Code", "Robert C. Martin"\)\)) Tj
T* () Tj
