(import sqlite3) Tj
T* () Tj
T* (conn = sqlite3.connect\('university.db'\)) Tj
T* (cur = conn.cursor\(\)) Tj
T* () Tj
T* (cur.executescript\(''') Tj
T* (DROP TABLE IF EXISTS Member;) Tj
T* (DROP TABLE IF EXISTS User;) Tj
T* (DROP TABLE IF EXISTS Course;) Tj
T* () Tj
T* (CREATE TABLE User \() Tj
T* (id INTEGER PRIMARY KEY AUTOINCREMENT,) Tj
T* (name TEXT NOT NULL) Tj
T* (\);) Tj
T* () Tj
T* (CREATE TABLE Course \() Tj
T* (id INTEGER PRIMARY KEY AUTOINCREMENT,) Tj
T* (title TEXT NOT NULL) Tj
T* (\);) Tj
T* () Tj
T* (CREATE TABLE Member \() Tj
T* (user_id INTEGER,) Tj
T* (course_id INTEGER,) Tj
T* (role INTEGER, - 1=Instructor, 0=Student) Tj
T* (PRIMARY KEY \(user_id, course_id\)) Tj
T* (\);) Tj
T* ('''\)) Tj
T* () Tj
T* (# Populate Users and Courses) Tj
T* (cur.execute\('INSERT INTO User \(name\) VALUES \(?\)', \('Dr. Charles Severance',\)\)) Tj
T* (u_chuck = cur.lastrowid) Tj
T* (cur.execute\('INSERT INTO User \(name\) VALUES \(?\)', \('Bhavana',\)\)) Tj
T* (u_bhavana = cur.lastrowid) Tj
T* () Tj
T* (cur.execute\('INSERT INTO Course \(title\) VALUES \(?\)', \('Python for Everybody',\)\)) Tj
T* (c_python = cur.lastrowid) Tj
T* () Tj
T* (# Link via Junction Table \(Member\)) Tj
T* (cur.execute\('INSERT INTO Member VALUES \(?, ?, ?\)', \(u_chuck, c_python, 1\)\) # Chuck is Instructor) Tj
T* (cur.execute\('INSERT INTO Member VALUES \(?, ?, ?\)', \(u_bhavana, c_python, 0\)\) # Bhavana is Student) Tj
T* (conn.commit\(\)) Tj
T* () Tj
T* (# Query Many-to-Many Roster) Tj
T* (cur.execute\(''') Tj
T* (SELECT User.name, Course.title, Member.role) Tj
T* (FROM User) Tj
T* (JOIN Member ON User.id = Member.user_id) Tj
T* (JOIN Course ON Member.course_id = Course.id) Tj
T* (ORDER BY Member.role DESC) Tj
T* ('''\)) Tj
T* () Tj
T* (print\("Course Roster:"\)) Tj
T* (for name, course, role in cur:) Tj
T* (role_str = "Instructor" if role == 1 else "Student") Tj
T* (print\(f" [{role_str:<10}] {name} in '{course}'"\)) Tj
T* () Tj
T* (conn.close\(\)) Tj
ET
