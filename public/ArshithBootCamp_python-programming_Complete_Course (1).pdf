(a = 10 # Binary: 1010) Tj
T* (b = 5 # Binary: 0101) Tj
T* () Tj
T* (print\("a & b \(Bitwise AND\):", a & b\) # 0000 -> 0) Tj
T* (print\("a | b \(Bitwise OR\):", a | b\) # 1111 -> 15) Tj
T* (print\("a ^ b \(Bitwise XOR\):", a ^ b\) # 1111 -> 15) Tj
T* (print\("~a \(Bitwise NOT\):", ~a\) # -\(10 + 1\) -> -11) Tj
T* () Tj
T* (# Bit shifting) Tj
T* (x = 5 # Binary: 0101) Tj
T* (print\("5 << 1 \(Left Shift\):", x << 1\) # 1010 -> 10 \(multiply by 2\)) Tj
T* (print\("10 >> 1 \(Right Shift\):", 10 >> 1\) # 0101 -> 5 \(divide by 2\)) Tj
