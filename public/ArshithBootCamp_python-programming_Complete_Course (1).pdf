(import logging) Tj
T* (import io) Tj
T* () Tj
T* (# Setup logger with custom formatting) Tj
T* (logger = logging.getLogger\("BillingEngine"\)) Tj
T* (logger.setLevel\(logging.DEBUG\)) Tj
T* () Tj
T* (# Create stream handler) Tj
T* (log_stream = io.StringIO\(\)) Tj
T* (handler = logging.StreamHandler\(log_stream\)) Tj
T* (formatter = logging.Formatter\('%\(asctime\)s | %\(levelname\)-8s | %\(name\)s | %\(message\)s',) Tj
T* (datefmt='%H:%M:%S'\)) Tj
T* (handler.setFormatter\(formatter\)) Tj
T* (logger.addHandler\(handler\)) Tj
T* () Tj
T* (def process_invoice\(account_id, amount\):) Tj
T* (logger.debug\(f"Starting invoice generation for account {account_id}"\)) Tj
T* () Tj
T* (if amount <= 0:) Tj
T* (logger.error\(f"Failed to generate invoice for {account_id}: Amount must be positive \({amount}\)"\)) Tj
T* (return False) Tj
T* () Tj
T* (if amount > 10000:) Tj
T* (logger.warning\(f"Large transaction flagged for account {account_id}: $" + f"{amount:,.2f}"\)) Tj
T* () Tj
T* (logger.info\(f"Invoice for account {account_id} created successfully."\)) Tj
T* (return True) Tj
T* () Tj
T* (process_invoice\("ACC-9041", 12500\)) Tj
T* (process_invoice\("ACC-3312", -50\)) Tj
T* () Tj
