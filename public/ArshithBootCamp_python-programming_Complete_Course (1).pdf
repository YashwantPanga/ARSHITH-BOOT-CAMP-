(from collections import namedtuple) Tj
T* () Tj
T* (# Single item tuple & immutable points) Tj
T* (point = \(4, 7\)) Tj
T* (single_item = \(5,\) # Notice trailing comma!) Tj
T* () Tj
T* (# Star \(*\) Extended Unpacking) Tj
T* (first, *middle, last = [10, 20, 30, 40, 50]) Tj
T* (print\(f"first={first}, middle={middle}, last={last}"\)) Tj
T* () Tj
T* (# Swapping variables) Tj
T* (a, b = 10, 20) Tj
T* (a, b = b, a) Tj
T* (print\(f"Swapped: a={a}, b={b}"\)) Tj
T* () Tj
T* (# namedtuple: readable records) Tj
T* (City = namedtuple\("City", ["name", "country", "population"]\)) Tj
T* (tokyo = City\("Tokyo", "Japan", 37400000\)) Tj
T* (print\(f"{tokyo.name}, {tokyo.country} \(Pop: {tokyo.population}\)"\)) Tj
