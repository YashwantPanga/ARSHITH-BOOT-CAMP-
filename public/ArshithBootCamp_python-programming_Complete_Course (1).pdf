(import socket) Tj
T* () Tj
T* (# Step 1: Create a stream TCP/IP socket) Tj
T* (sock = socket.socket\(socket.AF_INET, socket.SOCK_STREAM\)) Tj
T* () Tj
T* (# Step 2: Establish connection to host on Port 80 \(HTTP\)) Tj
T* (target_host = "data.pr4e.org") Tj
T* (target_port = 80) Tj
T* (sock.connect\(\(target_host, target_port\)\)) Tj
T* (print\(f"TCP Handshake successful with {target_host}:{target_port}"\)) Tj
T* () Tj
T* (# Step 3: Construct strict HTTP 1.1 GET request with CRLF line breaks) Tj
T* (http_request = "GET /code3/romeo.txt HTTP/1.1) Tj
T* (Host: data.pr4e.org) Tj
T* (Connection: close) Tj
T* () Tj
T* (") Tj
T* () Tj
T* (# Step 4: Encode Unicode string into raw ASCII/UTF-8 bytes and transmit) Tj
T* (sock.sendall\(http_request.encode\('utf-8'\)\)) Tj
T* () Tj
T* (# Step 5: Receive byte buffer in chunks until EOF) Tj
T* (received_payload = "") Tj
T* (while True:) Tj
T* (data_chunk = sock.recv\(512\)) Tj
T* (if len\(data_chunk\) < 1:) Tj
T* (break # Connection closed by remote server) Tj
T* (received_payload += data_chunk.decode\('utf-8'\)) Tj
T* () Tj
T* (sock.close\(\)) Tj
T* () Tj
T* (# Split headers and body at the blank line marker) Tj
T* (headers, body = received_payload.split\(') Tj
T* () Tj
T* (', 1\)) Tj
T* (print\("--- HTTP Response Headers ---"\)) Tj
T* (print\(headers\)) Tj
T* (print\(") Tj
T* (--- Response Body Payload ---"\)) Tj
T* (print\(body.strip\(\)\)) Tj
ET
