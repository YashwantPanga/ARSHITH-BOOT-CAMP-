(class BankAccount:) Tj
T* (def __init__\(self, account_holder, initial_balance=0.0\):) Tj
T* (self.account_holder = account_holder) Tj
T* (self._balance = float\(initial_balance\) # Protected internal state) Tj
T* () Tj
T* (@property) Tj
T* (def balance\(self\):) Tj
T* ("""Getter method: Read-only external access to balance.""") Tj
T* (return self._balance) Tj
T* () Tj
T* (@balance.setter) Tj
T* (def balance\(self, new_balance\):) Tj
T* ("""Setter method: Validates balance updates rigorously.""") Tj
T* (if new_balance < 0:) Tj
T* (raise ValueError\(f"Balance cannot fall below zero: {new_balance}"\)) Tj
T* (self._balance = float\(new_balance\)) Tj
T* () Tj
T* (def deposit\(self, amount\):) Tj
T* (if amount <= 0:) Tj
T* (raise ValueError\("Deposit amount must be positive."\)) Tj
T* (self.balance += amount) Tj
T* (return self.balance) Tj
T* () Tj
T* (account = BankAccount\("Dr. Ananya Sharma", 2500\)) Tj
T* (print\(f"Account Balance: $" + f"{account.balance:,.2f}"\)) Tj
T* () Tj
T* (account.deposit\(750\)) Tj
T* (print\(f"Updated Balance: $" + f"{account.balance:,.2f}"\)) Tj
T* () Tj
T* (try:) Tj
T* (account.balance = -500 # Triggers setter validation exception) Tj
T* (except ValueError as e:) Tj
T* (print\(f"Guard Blocked Invalid Transaction: {e}"\)) Tj
