(import urllib.request) Tj
T* () Tj
T* (target_url = "http://data.pr4e.org/romeo.txt") Tj
T* () Tj
T* (# Define professional User-Agent headers) Tj
T* (custom_headers = {) Tj
T* ('User-Agent': 'ArshithResearchCrawler/1.0 \(+https://arshithbootcamp.com/crawler-policy\)',) Tj
T* ('Accept': 'text/plain, text/html') Tj
T* (}) Tj
T* () Tj
T* (# Construct Request object with custom headers) Tj
T* (req = urllib.request.Request\(target_url, headers=custom_headers\)) Tj
T* () Tj
T* (try:) Tj
T* (with urllib.request.urlopen\(req\) as resp:) Tj
T* (print\(f"Request Succeeded: HTTP {resp.status}"\)) Tj
T* (sample = resp.read\(100\).decode\('utf-8'\)) Tj
T* (print\(f"Snippet: {sample.strip\(\)}..."\)) Tj
T* (except urllib.error.HTTPError as http_err:) Tj
T* (print\(f"HTTP Error: {http_err.code} - {http_err.reason}"\)) Tj
