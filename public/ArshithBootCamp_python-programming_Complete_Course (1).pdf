(import time) Tj
T* () Tj
T* (def mock_weather_api_call\(attempt_counter\):) Tj
T* (if attempt_counter[0] < 2:) Tj
T* (attempt_counter[0] += 1) Tj
T* (# Simulate HTTP 429 Too Many Requests) Tj
T* (raise Exception\("HTTP Error 429: Too Many Requests \(Rate limit exceeded\)"\)) Tj
T* (return {"city": "Bengaluru", "temperature_c": 28.5, "condition": "Partly Cloudy"}) Tj
T* () Tj
T* (def fetch_with_backoff\(api_func, max_attempts=3, backoff_factor=0.2\):) Tj
T* (attempts = [0]) Tj
T* (for i in range\(1, max_attempts + 1\):) Tj
T* (try:) Tj
T* (return api_func\(attempts\)) Tj
T* (except Exception as err:) Tj
T* (if "429" in str\(err\) and i < max_attempts:) Tj
T* (sleep_time = backoff_factor * \(2 ** \(i - 1\)\)) Tj
T* (print\(f"Rate limited on attempt {i}. Backing off for {sleep_time:.2f}s..."\)) Tj
T* (time.sleep\(sleep_time\)) Tj
T* (else:) Tj
T* (raise) Tj
T* () Tj
T* (weather_data = fetch_with_backoff\(mock_weather_api_call\)) Tj
T* (print\(f") Tj
T* (Resilient API Response Received:"\)) Tj
T* (print\(f" City: {weather_data['city']} | Temp: {weather_data['temperature_c']} deg C | Weather:) Tj
T* ({weather_data['condition']}"\)) Tj
