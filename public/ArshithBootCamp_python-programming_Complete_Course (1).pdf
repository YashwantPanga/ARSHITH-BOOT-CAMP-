(import json) Tj
T* (import urllib.parse) Tj
T* (import xml.etree.ElementTree as ET) Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 1: XML Course Catalog Parser) Tj
T* (# ==============================================================================) Tj
T* (xml_catalog = """) Tj
T* (<catalog>) Tj
T* (<course id="PY-101" category="Programming">) Tj
T* (<title>Python Masterclass</title>) Tj
T* (<duration_hours>40</duration_hours>) Tj
T* (<modules>) Tj
T* (<module order="1">Introduction to Python</module>) Tj
T* (<module order="2">Variables &amp; Types</module>) Tj
T* (<module order="3">Data Structures</module>) Tj
T* (</modules>) Tj
T* (</course>) Tj
T* (<course id="SQL-201" category="Data">) Tj
T* (<title>SQL for Analytics</title>) Tj
T* (<duration_hours>25</duration_hours>) Tj
T* (<modules>) Tj
T* (<module order="1">RDBMS Fundamentals</module>) Tj
T* (<module order="2">Complex Queries &amp; Joins</module>) Tj
T* (</modules>) Tj
T* (</course>) Tj
T* (</catalog>) Tj
T* (""") Tj
T* () Tj
T* (def parse_xml_catalog\(raw_xml\):) Tj
T* (root = ET.fromstring\(raw_xml.strip\(\)\)) Tj
T* (courses = []) Tj
T* () Tj
T* (for c in root.findall\('course'\):) Tj
T* (course_id = c.get\('id'\)) Tj
T* (category = c.get\('category'\)) Tj
T* (title = c.find\('title'\).text) Tj
T* (hours = int\(c.find\('duration_hours'\).text\)) Tj
T* () Tj
T* (mods = [m.text for m in c.find\('modules'\).findall\('module'\)]) Tj
T* (courses.append\({) Tj
T* ("id": course_id,) Tj
T* ("category": category,) Tj
T* ("title": title,) Tj
T* ("hours": hours,) Tj
T* ("modules": mods) Tj
T* (}\)) Tj
T* (return courses) Tj
T* () Tj
T* (parsed_catalog = parse_xml_catalog\(xml_catalog\)) Tj
T* (print\("Challenge 1 - Parsed XML Course Catalog:"\)) Tj
T* (for c in parsed_catalog:) Tj
T* (print\(f" [{c['id']}] {c['title']} \({c['hours']}h\) - {len\(c['modules']\)} modules"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 2: JSON User Profile Transformer) Tj
T* (# ==============================================================================) Tj
T* (raw_users_json = """) Tj
T* ([) Tj
T* ({"id": 1, "name": "Ananya", "active": true, "age": 28},) Tj
T* ({"id": 2, "name": "Rahul", "active": false, "age": 22},) Tj
T* ({"id": 3, "name": "Priya", "active": true, "age": 31},) Tj
T* ({"id": 4, "name": "John", "active": true, "age": 25}) Tj
T* (]) Tj
T* (""") Tj
T* () Tj
T* (def transform_active_user_metrics\(json_str\):) Tj
T* (users = json.loads\(json_str\)) Tj
T* (active_users = [u for u in users if u.get\('active'\)]) Tj
T* (avg_age = sum\(u['age'] for u in active_users\) / len\(active_users\) if active_users else 0) Tj
T* () Tj
T* (report = {) Tj
T* ("total_records": len\(users\),) Tj
T* ("active_count": len\(active_users\),) Tj
T* ("average_active_age": round\(avg_age, 1\),) Tj
T* ("active_members": [u['name'] for u in active_users]) Tj
T* (}) Tj
T* (return json.dumps\(report, indent=2\)) Tj
T* () Tj
T* (report_json = transform_active_user_metrics\(raw_users_json\)) Tj
T* (print\(f") Tj
T* (Challenge 2 - Active User JSON Report:) Tj
T* ({report_json}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 3: Safe Geocoding Query Builder) Tj
T* (# ==============================================================================) Tj
T* (def build_geocoding_request\(address, api_key\):) Tj
T* (if not address or not isinstance\(address, str\):) Tj
T* (raise ValueError\("Address must be a non-empty string."\)) Tj
T* () Tj
T* (base_endpoint = "https://maps.googleapis.com/maps/api/geocode/json") Tj
T* (params = {) Tj
T* ("address": address.strip\(\),) Tj
T* ("key": api_key,) Tj
T* ("sensor": "false") Tj
T* (}) Tj
T* (encoded = urllib.parse.urlencode\(params\)) Tj
T* (return f"{base_endpoint}?{encoded}") Tj
T* () Tj
T* (test_url = build_geocoding_request\("MG Road, Bengaluru, Karnataka, India", "AIzaSy_demo_key_2026"\)) Tj
T* (print\(f") Tj
T* (Challenge 3 - Encoded Geocoding URL:) Tj
T* ({test_url}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 4: Open-Meteo Weather Data Consumer) Tj
T* (# ==============================================================================) Tj
T* (mock_weather_response = """{) Tj
T* ("latitude": 12.97,) Tj
T* ("longitude": 77.59,) Tj
T* ("current_weather": {) Tj
T* ("temperature": 27.8,) Tj
T* ("windspeed": 11.2,) Tj
T* ("weathercode": 2) Tj
T* (}) Tj
T* (}""") Tj
T* () Tj
T* (def parse_weather_payload\(json_payload\):) Tj
T* (data = json.loads\(json_payload\)) Tj
T* (current = data.get\("current_weather", {}\)) Tj
T* (return {) Tj
T* ("coordinates": f"{data.get\('latitude'\)}, {data.get\('longitude'\)}",) Tj
T* ("temperature_celsius": current.get\("temperature"\),) Tj
T* ("wind_speed_kmh": current.get\("windspeed"\),) Tj
T* ("status_code": current.get\("weathercode"\)) Tj
T* (}) Tj
T* () Tj
T* (weather_report = parse_weather_payload\(mock_weather_response\)) Tj
T* (print\(") Tj
T* (Challenge 4 - Weather Metrics Parsed:"\)) Tj
T* (for k, v in weather_report.items\(\):) Tj
T* (print\(f" {k:<22}: {v}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 5: API Authenticated Gateway Client with Token Refresh) Tj
T* (# ==============================================================================) Tj
T* (class AuthenticatedApiClient:) Tj
T* (def __init__\(self, client_id, secret\):) Tj
T* (self.client_id = client_id) Tj
T* (self.secret = secret) Tj
T* (self.token = None) Tj
T* () Tj
T* (def authenticate\(self\):) Tj
T* (# Simulates acquiring a new Bearer token) Tj
T* (self.token = f"tok_bearer_{self.client_id}_active") Tj
T* (return self.token) Tj
T* () Tj
T* (def execute_request\(self, endpoint, simulate_expired=False\):) Tj
T* (if not self.token or simulate_expired:) Tj
T* (self.authenticate\(\)) Tj
T* () Tj
T* (headers = {"Authorization": f"Bearer {self.token}"}) Tj
T* (return {"status": 200, "endpoint": endpoint, "auth_header": headers["Authorization"]}) Tj
T* () Tj
T* (client = AuthenticatedApiClient\("app-901", "sec-xyz"\)) Tj
T* (res1 = client.execute_request\("/v1/profile"\)) Tj
T* (print\(f") Tj
T* (Challenge 5 - Authenticated API Client:"\)) Tj
T* (print\(f" Token Initialized: {res1['auth_header']}"\)) Tj
T* (res2 = client.execute_request\("/v1/billing", simulate_expired=True\)) Tj
T* (print\(f" Token Refreshed: {res2['auth_header']}"\)) Tj
ET
