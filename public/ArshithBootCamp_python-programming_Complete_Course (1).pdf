(html_snippet = """<div class="course">Python Programming</div><div class="badge">Featured</div>""") Tj
T* () Tj
T* (import re) Tj
T* () Tj
T* (# 1. Greedy Pattern \(Consumes up to the LAST closing tag\)) Tj
T* (greedy_pattern = r'<div.*>.*</div>') Tj
T* (greedy_match = re.search\(greedy_pattern, html_snippet\)) Tj
T* (print\(f"Greedy Match \(Single giant match\):) Tj
T* ({greedy_match.group\(0\)}) Tj
T* ("\)) Tj
T* () Tj
T* (# 2. Non-Greedy Pattern \(Stops at the EARLIEST possible closing tag\)) Tj
T* (non_greedy_pattern = r'<div.*?>.*?</div>') Tj
T* (non_greedy_matches = re.findall\(non_greedy_pattern, html_snippet\)) Tj
T* (print\(f"Non-Greedy Matches \({len\(non_greedy_matches\)} distinct tags\):"\)) Tj
T* (for i, tag in enumerate\(non_greedy_matches, 1\):) Tj
T* (print\(f" Match {i}: {tag}"\)) Tj
ET
