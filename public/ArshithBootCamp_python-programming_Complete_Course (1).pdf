(import urllib.parse) Tj
T* (import urllib.request) Tj
T* (import json) Tj
T* () Tj
T* (base_api_url = "https://nominatim.openstreetmap.org/search") Tj
T* () Tj
T* (# Dictionary of raw search query parameters) Tj
T* (search_parameters = {) Tj
T* ("q": "Bengaluru, Karnataka, India",) Tj
T* ("format": "json",) Tj
T* ("limit": 1) Tj
T* (}) Tj
T* () Tj
T* (# Safe URL encoding) Tj
T* (encoded_query = urllib.parse.urlencode\(search_parameters\)) Tj
T* (complete_url = f"{base_api_url}?{encoded_query}") Tj
T* () Tj
T* (print\(f"Constructed URL:) Tj
T* ({complete_url}) Tj
T* ("\)) Tj
T* () Tj
T* (# Request with polite User-Agent header \(required by OpenStreetMap policy\)) Tj
T* (req = urllib.request.Request\() Tj
T* (complete_url,) Tj
T* (headers={'User-Agent': 'ArshithBootCampGeocodingLab/1.0'}) Tj
T* (\)) Tj
T* () Tj
T* (try:) Tj
T* (with urllib.request.urlopen\(req, timeout=5\) as response:) Tj
T* (raw_json = response.read\(\).decode\('utf-8'\)) Tj
T* (results = json.loads\(raw_json\)) Tj
T* (if results:) Tj
T* (first_match = results[0]) Tj
T* (print\(f"Location: {first_match['display_name']}"\)) Tj
T* (print\(f"Latitude: {first_match['lat']}, Longitude: {first_match['lon']}"\)) Tj
T* (except Exception as err:) Tj
T* (print\(f"Live API Query Note: Network or timeout \({err}\) - simulated query successfully built."\)) Tj
