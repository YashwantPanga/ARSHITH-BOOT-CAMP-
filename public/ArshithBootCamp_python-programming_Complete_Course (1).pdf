(import io) Tj
T* (import urllib.request) Tj
T* () Tj
T* (# Simulate downloading a binary asset \(e.g. image or manual PDF\)) Tj
T* (# Using a chunked reading loop to prevent RAM spikes on large media files) Tj
T* (def download_stream_to_buffer\(url, chunk_size=4096\):) Tj
T* (memory_buffer = io.BytesIO\(\)) Tj
T* (total_bytes = 0) Tj
T* () Tj
T* (req = urllib.request.Request\(url, headers={'User-Agent': 'PythonDownloader/3.10'}\)) Tj
T* (with urllib.request.urlopen\(req\) as response:) Tj
T* (while True:) Tj
T* (chunk = response.read\(chunk_size\)) Tj
T* (if not chunk:) Tj
T* (break) Tj
T* (memory_buffer.write\(chunk\)) Tj
T* (total_bytes += len\(chunk\)) Tj
T* () Tj
T* (memory_buffer.seek\(0\)) Tj
T* (return memory_buffer, total_bytes) Tj
T* () Tj
T* (# Test on live sample file) Tj
T* (buffer, size = download_stream_to_buffer\("http://data.pr4e.org/cover3.jpg"\)) Tj
T* (print\(f"Binary Download Complete: {size} bytes loaded into memory buffer."\)) Tj
ET
