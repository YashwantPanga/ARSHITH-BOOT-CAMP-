(text = "The quick brown fox jumps over the lazy dog") Tj
T* () Tj
T* (# Character and substring counting) Tj
T* (print\("Occurrences of 'o':", text.count\('o'\)\)) Tj
T* (print\("Occurrences of 'the' \(case-sensitive\):", text.count\('the'\)\)) Tj
T* () Tj
T* (# Membership checking with 'in' and 'not in') Tj
T* (print\("Is 'fox' in text?", "fox" in text\)) Tj
T* (print\("Is 'cat' not in text?", "cat" not in text\)) Tj
T* () Tj
T* (# Lexicographical comparison & Uppercase trap) Tj
T* (print\("'apple' < 'banana':", "apple" < "banana"\)) Tj
T* (print\("'apple' > 'Zebra':", "apple" > "Zebra"\) # True! \('a'=97 > 'Z'=90\)) Tj
