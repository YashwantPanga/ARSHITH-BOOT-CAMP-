(import sqlite3) Tj
T* (import json) Tj
T* () Tj
T* (conn = sqlite3.connect\(':memory:'\) # High-speed in-memory database for pipeline) Tj
T* (cur = conn.cursor\(\)) Tj
T* () Tj
T* (cur.execute\('CREATE TABLE PageVisits \(endpoint TEXT, response_time_ms INTEGER\)'\)) Tj
T* () Tj
T* (# Ingest sample telemetry) Tj
T* (mock_visits = [) Tj
T* (\('/courses/python', 45\), \('/courses/python', 52\), \('/courses/python', 48\),) Tj
T* (\('/courses/sql', 65\), \('/courses/sql', 72\),) Tj
T* (\('/api/v1/auth', 110\), \('/api/v1/auth', 125\)) Tj
T* (]) Tj
T* (cur.executemany\('INSERT INTO PageVisits VALUES \(?, ?\)', mock_visits\)) Tj
T* (conn.commit\(\)) Tj
T* () Tj
T* (# Analytical SQL Aggregation \(GROUP BY, COUNT, AVG\)) Tj
T* (cur.execute\(''') Tj
T* (SELECT endpoint, COUNT\(*\) as hits, ROUND\(AVG\(response_time_ms\), 1\) as avg_latency) Tj
T* (FROM PageVisits) Tj
T* (GROUP BY endpoint) Tj
T* (ORDER BY hits DESC) Tj
T* ('''\)) Tj
T* () Tj
T* (visualization_data = []) Tj
T* (for endpoint, hits, avg_lat in cur:) Tj
T* (visualization_data.append\({) Tj
T* ("route": endpoint,) Tj
T* ("traffic_hits": hits,) Tj
T* ("latency_ms": avg_lat) Tj
T* (}\)) Tj
T* () Tj
T* (# Export to clean JSON ready for frontend charts \(Chart.js / D3\)) Tj
T* (exported_json = json.dumps\(visualization_data, indent=2\)) Tj
T* (print\("Pipeline Export for Dashboard Visualization:"\)) Tj
T* (print\(exported_json\)) Tj
T* () Tj
T* (conn.close\(\)) Tj
ET
