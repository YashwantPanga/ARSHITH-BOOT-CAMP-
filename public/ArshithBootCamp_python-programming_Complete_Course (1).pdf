(from collections import Counter) Tj
T* () Tj
T* (# Frequency counting) Tj
T* (words = ["sun", "rain", "sun", "wind", "sun", "rain"]) Tj
T* (word_counts = Counter\(words\)) Tj
T* (print\("Top word:", word_counts.most_common\(1\)\)) Tj
T* () Tj
T* (# Python 3.9+ Dictionary Merge \(|\) and Update \(|=\)) Tj
T* (defaults = {"theme": "light", "font": "sans", "zoom": 100}) Tj
T* (user_pref = {"theme": "dark", "zoom": 120}) Tj
T* (active_settings = defaults | user_pref # user_pref overrides defaults) Tj
T* (print\("Merged settings \(|\):", active_settings\)) Tj
T* () Tj
T* (# Dictionary comprehension) Tj
T* (squares_dict = {x: x ** 2 for x in range\(1, 6\)}) Tj
T* (print\("Squares dict:", squares_dict\)) Tj
ET
