(import json) Tj
T* () Tj
T* (# Python Data Structure \(Dictionary containing lists and nested dicts\)) Tj
T* (course_payload = {) Tj
T* ("course_id": "python-01",) Tj
T* ("title": "Python Programming Masterclass",) Tj
T* ("is_certified": True,) Tj
T* ("rating": 4.9,) Tj
T* ("instructors": ["Dr. Ananya Sharma", "Dr. Charles Severance"],) Tj
T* ("metrics": {) Tj
T* ("enrolled_students": 14200,) Tj
T* ("completion_rate": 0.88) Tj
T* (},) Tj
T* ("prerequisites": None) Tj
T* (}) Tj
T* () Tj
T* (# 1. Serialization: Convert Python object -> Formatted JSON String) Tj
T* (json_string = json.dumps\(course_payload, indent=2, sort_keys=True\)) Tj
T* (print\("--- Serialized JSON String ---"\)) Tj
T* (print\(json_string[:250] + ") Tj
T* (...) Tj
T* ("\)) Tj
T* () Tj
T* (# 2. Deserialization: Convert JSON String -> Native Python Dictionary) Tj
T* (reconstructed = json.loads\(json_string\)) Tj
T* (print\("--- Deserialized Native Python Access ---"\)) Tj
T* (print\(f"Course: {reconstructed['title']}"\)) Tj
T* (print\(f"Is Certified: {reconstructed['is_certified']} \(Python Type:) Tj
T* ({type\(reconstructed['is_certified']\).__name__}\)"\)) Tj
T* (print\(f"Prerequisites: {reconstructed['prerequisites']} \(Python Type:) Tj
T* ({type\(reconstructed['prerequisites']\).__name__}\)"\)) Tj
