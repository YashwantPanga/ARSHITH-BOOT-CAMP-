(try:) Tj
T* (number = int\(input\("Enter a whole number: "\)\)) Tj
T* (print\("You entered:", number\)) Tj
T* (except ValueError:) Tj
T* (print\("That was not a valid whole number."\)) Tj
T* () Tj
T* (# 2. Handling different errors differently with else clause) Tj
T* (try:) Tj
T* (numerator = int\(input\("Numerator: "\)\)) Tj
T* (denominator = int\(input\("Denominator: "\)\)) Tj
T* (result = numerator / denominator) Tj
T* (except ValueError:) Tj
T* (print\("Please enter whole numbers."\)) Tj
T* (except ZeroDivisionError:) Tj
T* (print\("The denominator cannot be zero."\)) Tj
T* (else:) Tj
T* (print\("The result is:", result\)) Tj
T* () Tj
T* (# 3. Inspecting exception message and using finally for cleanup) Tj
T* (try:) Tj
T* (print\("Trying an operation..."\)) Tj
T* (val = int\("not a number"\)) Tj
T* (except ValueError as error:) Tj
T* (print\("Conversion failed:", error\)) Tj
T* (finally:) Tj
T* (print\("This cleanup message always runs regardless of errors."\)) Tj
