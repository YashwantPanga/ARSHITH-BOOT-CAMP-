(import math) Tj
T* (import random) Tj
T* () Tj
T* (# Program 1: Gross Pay Calculator) Tj
T* (def computepay\(hours, rate\):) Tj
T* (if hours > 40:) Tj
T* (regular_pay = 40 * rate) Tj
T* (overtime_pay = \(hours - 40\) * \(rate * 1.5\)) Tj
T* (return regular_pay + overtime_pay) Tj
T* (return hours * rate) Tj
T* () Tj
T* (print\("Pay for 45 hrs @ $10/hr:", computepay\(45, 10\)\)) Tj
T* () Tj
T* (# Program 2: Circle Geometry Helper) Tj
T* (def circle_properties\(radius\):) Tj
T* (circumference = 2 * math.pi * radius) Tj
T* (area = math.pi * \(radius ** 2\)) Tj
T* (return round\(circumference, 2\), round\(area, 2\)) Tj
T* () Tj
T* (circ, area = circle_properties\(5\)) Tj
T* (print\(f"Radius 5 -> Circumference: {circ}, Area: {area}"\)) Tj
T* () Tj
T* (# Program 3: Dice Rolling Simulator) Tj
T* (def roll_dice\(num_dice=2, sides=6\):) Tj
T* (rolls = [random.randint\(1, sides\) for _ in range\(num_dice\)]) Tj
T* (return rolls, sum\(rolls\)) Tj
T* () Tj
T* (rolls, total = roll_dice\(\)) Tj
T* (print\(f"Rolled {rolls} with Total = {total}"\)) Tj
T* () Tj
T* (# Program 4: Temperature Classifier) Tj
T* (def classify_temperature\(temp_c\):) Tj
T* (temp_f = temp_c * 9 / 5 + 32) Tj
T* (if temp_f <= 32:) Tj
T* (status = "Freezing") Tj
T* (elif temp_f >= 85:) Tj
T* (status = "Hot") Tj
T* (else:) Tj
T* (status = "Moderate") Tj
T* (return f"{temp_c} deg C \({temp_f:.1f} deg F\) is {status}") Tj
T* () Tj
T* (print\(classify_temperature\(0\)\)) Tj
T* (print\(classify_temperature\(20\)\)) Tj
T* (print\(classify_temperature\(35\)\)) Tj
