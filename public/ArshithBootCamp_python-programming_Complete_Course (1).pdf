(import sqlite3) Tj
T* (import json) Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 1: Student Grading Database System) Tj
T* (# ==============================================================================) Tj
T* (conn = sqlite3.connect\(':memory:'\)) Tj
T* (cur = conn.cursor\(\)) Tj
T* () Tj
T* (cur.execute\(''') Tj
T* (CREATE TABLE StudentGrades \() Tj
T* (id INTEGER PRIMARY KEY AUTOINCREMENT,) Tj
T* (name TEXT NOT NULL,) Tj
T* (course TEXT NOT NULL,) Tj
T* (score INTEGER NOT NULL) Tj
T* (\)) Tj
T* ('''\)) Tj
T* () Tj
T* (records = [) Tj
T* (\("Ananya", "Python", 98\),) Tj
T* (\("Rahul", "Python", 92\),) Tj
T* (\("Priya", "SQL", 95\),) Tj
T* (\("John", "SQL", 85\)) Tj
T* (]) Tj
T* (cur.executemany\('INSERT INTO StudentGrades \(name, course, score\) VALUES \(?, ?, ?\)', records\)) Tj
T* (conn.commit\(\)) Tj
T* () Tj
T* (cur.execute\(''') Tj
T* (SELECT course, COUNT\(*\) as total_students, ROUND\(AVG\(score\), 1\) as avg_score) Tj
T* (FROM StudentGrades) Tj
T* (GROUP BY course) Tj
T* (ORDER BY avg_score DESC) Tj
T* ('''\)) Tj
T* () Tj
T* (print\("Challenge 1 - Course Averages:"\)) Tj
T* (for course, count, avg in cur:) Tj
T* (print\(f" Course: {course:<10} | Enrolled: {count} | Average Score: {avg}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 2: Normalized Music Library Database) Tj
T* (# ==============================================================================) Tj
T* (cur.executescript\(''') Tj
T* (CREATE TABLE Artist \(id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT\);) Tj
T* (CREATE TABLE Album \(id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT, artist_id INTEGER\);) Tj
T* (CREATE TABLE Track \(id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT, album_id INTEGER\);) Tj
T* ('''\)) Tj
T* () Tj
T* (cur.execute\('INSERT INTO Artist \(name\) VALUES \(?\)', \('Pink Floyd',\)\)) Tj
T* (art_id = cur.lastrowid) Tj
T* (cur.execute\('INSERT INTO Album \(title, artist_id\) VALUES \(?, ?\)', \('The Dark Side of the Moon',) Tj
T* (art_id\)\)) Tj
T* (alb_id = cur.lastrowid) Tj
T* (cur.execute\('INSERT INTO Track \(title, album_id\) VALUES \(?, ?\)', \('Time', alb_id\)\)) Tj
T* (cur.execute\('INSERT INTO Track \(title, album_id\) VALUES \(?, ?\)', \('Money', alb_id\)\)) Tj
T* (conn.commit\(\)) Tj
T* () Tj
T* (cur.execute\(''') Tj
T* (SELECT Track.title, Album.title, Artist.name) Tj
T* (FROM Track) Tj
T* (JOIN Album ON Track.album_id = Album.id) Tj
T* (JOIN Artist ON Album.artist_id = Artist.id) Tj
T* ('''\)) Tj
T* (print\(") Tj
T* (Challenge 2 - Normalized Catalog JOIN:"\)) Tj
T* (for track, album, artist in cur:) Tj
T* (print\(f" '{track}' from album '{album}' by {artist}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 3: Many-to-Many University Enrollment System) Tj
T* (# ==============================================================================) Tj
T* (cur.executescript\(''') Tj
T* (CREATE TABLE User \(id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT\);) Tj
T* (CREATE TABLE Course \(id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT\);) Tj
T* (CREATE TABLE Member \(user_id INTEGER, course_id INTEGER, PRIMARY KEY \(user_id, course_id\)\);) Tj
T* ('''\)) Tj
T* () Tj
T* (cur.execute\('INSERT INTO User \(name\) VALUES \(?\)', \('Ananya',\)\)) Tj
T* (u1 = cur.lastrowid) Tj
T* (cur.execute\('INSERT INTO User \(name\) VALUES \(?\)', \('Rahul',\)\)) Tj
T* (u2 = cur.lastrowid) Tj
T* (cur.execute\('INSERT INTO Course \(title\) VALUES \(?\)', \('Python Masterclass',\)\)) Tj
T* (c1 = cur.lastrowid) Tj
T* (cur.execute\('INSERT INTO Course \(title\) VALUES \(?\)', \('SQL Analytics',\)\)) Tj
T* (c2 = cur.lastrowid) Tj
T* () Tj
T* (# Enrollments) Tj
T* (cur.executemany\('INSERT INTO Member VALUES \(?, ?\)', [\(u1, c1\), \(u1, c2\), \(u2, c1\)]\)) Tj
T* (conn.commit\(\)) Tj
T* () Tj
T* (cur.execute\(''') Tj
T* (SELECT Course.title, COUNT\(Member.user_id\) as enrolled_count) Tj
T* (FROM Course) Tj
T* (LEFT JOIN Member ON Course.id = Member.course_id) Tj
T* (GROUP BY Course.id) Tj
T* ('''\)) Tj
T* (print\(") Tj
T* (Challenge 3 - Course Enrollment Totals:"\)) Tj
T* (for title, cnt in cur:) Tj
T* (print\(f" Course: {title:<22} | Total Students: {cnt}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 4: Data Visualization Exporter) Tj
T* (# ==============================================================================) Tj
T* (cur.execute\(''') Tj
T* (SELECT Course.title, COUNT\(Member.user_id\) as count) Tj
T* (FROM Course) Tj
T* (LEFT JOIN Member ON Course.id = Member.course_id) Tj
T* (GROUP BY Course.id) Tj
T* ('''\)) Tj
T* () Tj
T* (chart_payload = {) Tj
T* ("chart_type": "bar",) Tj
T* ("labels": [],) Tj
T* ("data_points": []) Tj
T* (}) Tj
T* () Tj
T* (for title, cnt in cur:) Tj
T* (chart_payload["labels"].append\(title\)) Tj
T* (chart_payload["data_points"].append\(cnt\)) Tj
T* () Tj
T* (exported = json.dumps\(chart_payload, indent=2\)) Tj
T* (print\(") Tj
T* (Challenge 4 - Chart.js JSON Export:) Tj
T* (" + exported\)) Tj
T* () Tj
T* (conn.close\(\)) Tj
ET
endstream
