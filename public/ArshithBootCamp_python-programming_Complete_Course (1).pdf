(filename = "server_log.txt") Tj
T* () Tj
T* (# Safe reading with context manager and UTF-8 encoding) Tj
T* (try:) Tj
T* (with open\(filename, mode="r", encoding="utf-8"\) as file:) Tj
T* (total_lines = 0) Tj
T* (total_chars = 0) Tj
T* () Tj
T* (for line in file:) Tj
T* (total_lines += 1) Tj
T* (total_chars += len\(line\)) Tj
T* (# Process each line with O\(1\) auxiliary RAM) Tj
T* (clean_text = line.rstrip\(\)) Tj
T* (if total_lines <= 3:) Tj
T* (print\(f"Sample Line {total_lines}: {clean_text}"\)) Tj
T* () Tj
T* (print\(f") Tj
T* (Processed {total_lines} total lines \({total_chars} bytes\)."\)) Tj
T* () Tj
T* (except FileNotFoundError:) Tj
T* (print\(f"Error: The target file '{filename}' was not found."\)) Tj
T* (except PermissionError:) Tj
T* (print\(f"Error: Access denied to read '{filename}'."\)) Tj
