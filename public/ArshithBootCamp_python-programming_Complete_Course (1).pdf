(import io) Tj
T* (import time) Tj
T* (import logging) Tj
T* (from collections import Counter) Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 1: Resilient Numerical Parser with Type Validation) Tj
T* (# ==============================================================================) Tj
T* (def safe_parse_int_list\(raw_values\):) Tj
T* (valid_integers = []) Tj
T* (error_count = 0) Tj
T* () Tj
T* (for item in raw_values:) Tj
T* (try:) Tj
T* (val = int\(item\)) Tj
T* (valid_integers.append\(val\)) Tj
T* (except \(ValueError, TypeError\) as err:) Tj
T* (error_count += 1) Tj
T* (# In production: logger.warning\(f"Skipping invalid token '{item}': {err}"\)) Tj
T* () Tj
T* (return valid_integers, error_count) Tj
T* () Tj
T* (tokens = ["42", "100", "invalid", "250", None, "78", "3.1415", "999"]) Tj
T* (valid_nums, errs = safe_parse_int_list\(tokens\)) Tj
T* (print\("Challenge 1 - Resilient Parser:"\)) Tj
T* (print\(f" Valid Integers \({len\(valid_nums\)}\): {valid_nums}"\)) Tj
T* (print\(f" Errors Filtered: {errs}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 2: Safe Configuration File Loader with Schema Validation) Tj
T* (# ==============================================================================) Tj
T* (class ConfigError\(Exception\):) Tj
T* (pass) Tj
T* () Tj
T* (class MissingConfigKeyError\(ConfigError\):) Tj
T* (def __init__\(self, key\):) Tj
T* (super\(\).__init__\(f"Mandatory configuration setting '{key}' is missing!"\)) Tj
T* (self.missing_key = key) Tj
T* () Tj
T* (def load_validated_config\(config_stream\):) Tj
T* (config = {}) Tj
T* (for line in config_stream:) Tj
T* (line = line.strip\(\)) Tj
T* (if not line or line.startswith\("#"\):) Tj
T* (continue) Tj
T* (if "=" in line:) Tj
T* (k, v = line.split\("=", 1\)) Tj
T* (config[k.strip\(\)] = v.strip\(\)) Tj
T* () Tj
T* (# Schema validation) Tj
T* (required_keys = ["DATABASE_HOST", "API_KEY"]) Tj
T* (for req in required_keys:) Tj
T* (if req not in config:) Tj
T* (raise MissingConfigKeyError\(req\)) Tj
T* () Tj
T* (return config) Tj
T* () Tj
T* (sample_config = """) Tj
T* (# Server Configuration) Tj
T* (DATABASE_HOST = db.internal.arshithgroup.com) Tj
T* (SERVER_PORT = 8080) Tj
T* (API_KEY = arshith_live_secret_key_2026) Tj
T* (""") Tj
T* () Tj
T* (cfg = load_validated_config\(io.StringIO\(sample_config\)\)) Tj
T* (print\(f") Tj
T* (Challenge 2 - Validated Config Loaded:"\)) Tj
T* (print\(f" Host: {cfg['DATABASE_HOST']}, Port: {cfg['SERVER_PORT']}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 3: Complete E-Commerce Transaction Lifecycle \(try/except/else/finally\)) Tj
T* (# ==============================================================================) Tj
T* (class PaymentError\(Exception\):) Tj
T* (pass) Tj
T* () Tj
T* (class InsufficientFunds\(PaymentError\):) Tj
T* (pass) Tj
T* () Tj
T* (def process_payment\(account_balance, charge_amount\):) Tj
T* (audit_trail = []) Tj
T* (receipt_issued = False) Tj
T* () Tj
T* (try:) Tj
T* (audit_trail.append\("Step 1: Validating balance"\)) Tj
T* (if charge_amount > account_balance:) Tj
T* (raise InsufficientFunds\(f"Requested $" + f"{charge_amount}, Available: $" + f"{account_balance}"\)) Tj
T* (account_balance -= charge_amount) Tj
T* (audit_trail.append\(f"Step 2: Successfully debited $" + f"{charge_amount}"\)) Tj
T* (except InsufficientFunds as fund_err:) Tj
T* (audit_trail.append\(f"Payment Exception: {fund_err}"\)) Tj
T* (else:) Tj
T* (audit_trail.append\("Step 3 \(else\): Issuing transaction receipt"\)) Tj
T* (receipt_issued = True) Tj
T* (finally:) Tj
T* (audit_trail.append\("Step 4 \(finally\): Closing payment gateway session"\)) Tj
T* () Tj
T* (return account_balance, receipt_issued, audit_trail) Tj
T* () Tj
T* (new_bal, success, log = process_payment\(500, 150\)) Tj
T* (print\(f") Tj
T* (Challenge 3 - Payment Lifecycle \(Success: {success}\):"\)) Tj
T* (for entry in log:) Tj
T* (print\(f" - {entry}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 4: Custom Banking Exception Hierarchy with Account Lockout) Tj
T* (# ==============================================================================) Tj
T* (class BankAccountError\(Exception\):) Tj
T* (pass) Tj
T* () Tj
T* (class InsufficientBalanceError\(BankAccountError\):) Tj
T* (pass) Tj
T* () Tj
T* (class AccountLockedError\(BankAccountError\):) Tj
T* (pass) Tj
T* () Tj
T* (class SecureAccount:) Tj
T* (def __init__\(self, owner, balance\):) Tj
T* (self.owner = owner) Tj
T* (self.balance = balance) Tj
T* (self.failed_attempts = 0) Tj
T* (self.is_locked = False) Tj
T* () Tj
T* (def withdraw\(self, amount\):) Tj
T* (if self.is_locked:) Tj
T* (raise AccountLockedError\(f"Account for {self.owner} is locked due to security thresholds."\)) Tj
T* () Tj
T* (if amount > self.balance:) Tj
T* (self.failed_attempts += 1) Tj
T* (if self.failed_attempts >= 3:) Tj
T* (self.is_locked = True) Tj
T* (raise AccountLockedError\(f"Account locked! Exceeded 3 failed withdrawals."\)) Tj
T* (raise InsufficientBalanceError\(f"Cannot withdraw {amount}. Current balance: {self.balance}) Tj
T* (\(Failed: {self.failed_attempts}/3\)"\)) Tj
T* () Tj
T* (self.balance -= amount) Tj
T* (self.failed_attempts = 0) Tj
T* (return self.balance) Tj
T* () Tj
T* (acct = SecureAccount\("Rahul Kumar", 100\)) Tj
T* (print\(f") Tj
T* (Challenge 4 - Account Lockout Simulation:"\)) Tj
T* (for i in range\(1, 4\):) Tj
T* (try:) Tj
T* (acct.withdraw\(500\)) Tj
T* (except \(InsufficientBalanceError, AccountLockedError\) as e:) Tj
T* (print\(f" Attempt {i}: {e}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 5: Chained Exception Translator \(API Adapter Pattern\)) Tj
T* (# ==============================================================================) Tj
T* (class ApplicationGatewayError\(Exception\):) Tj
T* ("""High-level enterprise gateway error.""") Tj
T* (pass) Tj
T* () Tj
T* (def execute_external_network_call\(simulate_fail=True\):) Tj
T* (try:) Tj
T* (if simulate_fail:) Tj
T* (raise ConnectionRefusedError\("Remote TCP connection refused on port 443"\)) Tj
T* (return {"data": "verified"}) Tj
T* (except ConnectionRefusedError as net_err:) Tj
T* (raise ApplicationGatewayError\("External service unavailable; retry scheduled"\) from net_err) Tj
T* () Tj
T* (try:) Tj
T* (execute_external_network_call\(True\)) Tj
T* (except ApplicationGatewayError as app_err:) Tj
T* (print\(f") Tj
T* (Challenge 5 - Exception Chaining:"\)) Tj
T* (print\(f" High-level caught: {app_err}"\)) Tj
T* (print\(f" Original root cause: {app_err.__cause__}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 6: Scientific Bisection Defect Hunter) Tj
T* (# ==============================================================================) Tj
T* (def process_record\(record\):) Tj
T* (# Simulates calculation that crashes on non-numeric value) Tj
T* (return float\(record\) ** 2) Tj
T* () Tj
T* (def bisect_corrupted_record\(records\):) Tj
T* (low = 0) Tj
T* (high = len\(records\) - 1) Tj
T* (step_count = 0) Tj
T* () Tj
T* (while low <= high:) Tj
T* (step_count += 1) Tj
T* (mid = \(low + high\) // 2) Tj
T* () Tj
T* (# Test if the defect is in the left half [low .. mid]) Tj
T* (left_has_error = False) Tj
T* (for i in range\(low, mid + 1\):) Tj
T* (try:) Tj
T* (process_record\(records[i]\)) Tj
T* (except \(ValueError, TypeError\):) Tj
T* (left_has_error = True) Tj
T* (break) Tj
T* () Tj
T* (if left_has_error:) Tj
T* (if low == mid:) Tj
T* (return low, records[low], step_count) Tj
T* (high = mid) Tj
T* (else:) Tj
T* (low = mid + 1) Tj
T* () Tj
T* (return -1, None, step_count) Tj
T* () Tj
T* (# Generate 1,000 valid records with a single defect at index 732) Tj
T* (large_dataset = [str\(i * 1.5\) for i in range\(1000\)]) Tj
T* (large_dataset[732] = "CORRUPTED_TOKEN") Tj
T* () Tj
T* (bad_idx, bad_val, steps = bisect_corrupted_record\(large_dataset\)) Tj
T* (print\(f") Tj
T* (Challenge 6 - Bisection Defect Hunter:"\)) Tj
T* (print\(f" Corrupted record isolated at index: {bad_idx}"\)) Tj
T* (print\(f" Offending payload: {bad_val}"\)) Tj
T* (print\(f" Steps required: {steps} iterations \(O\(log N\) efficiency\)"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 7: Production Logging & Security Audit Recorder) Tj
T* (# ==============================================================================) Tj
T* (log_buffer = io.StringIO\(\)) Tj
T* (audit_logger = logging.getLogger\("SecurityAudit"\)) Tj
T* (audit_logger.setLevel\(logging.DEBUG\)) Tj
T* () Tj
T* (handler = logging.StreamHandler\(log_buffer\)) Tj
T* (handler.setFormatter\(logging.Formatter\('%\(levelname\)s: %\(message\)s'\)\)) Tj
T* (audit_logger.addHandler\(handler\)) Tj
T* () Tj
T* (def simulate_user_authentication\(username, password\):) Tj
T* (audit_logger.debug\(f"Auth attempt initiated for user: {username}"\)) Tj
T* (if username == "admin" and password == "secret2026":) Tj
T* (audit_logger.info\(f"User {username} authenticated successfully."\)) Tj
T* (return True) Tj
T* (elif username == "admin":) Tj
T* (audit_logger.error\(f"Failed password attempt for privileged account: {username}"\)) Tj
T* (return False) Tj
T* (else:) Tj
T* (audit_logger.warning\(f"Unknown username attempt: {username}"\)) Tj
T* (return False) Tj
T* () Tj
T* (simulate_user_authentication\("unknown_user", "pass"\)) Tj
T* (simulate_user_authentication\("admin", "wrong_pass"\)) Tj
T* (simulate_user_authentication\("admin", "secret2026"\)) Tj
T* () Tj
T* (print\(") Tj
T* (Challenge 7 - Security Audit Log Output:"\)) Tj
T* (print\(log_buffer.getvalue\(\).strip\(\)\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 8: Automated Retry Strategy with Jitter & Max Attempt Guard) Tj
T* (# ==============================================================================) Tj
T* (class MaxRetriesExceededError\(Exception\):) Tj
T* (pass) Tj
T* () Tj
T* (def execute_with_retry\(func, max_attempts=3, backoff_base=0.05\):) Tj
T* (for attempt in range\(1, max_attempts + 1\):) Tj
T* (try:) Tj
T* (return func\(\)) Tj
T* (except TimeoutError as te:) Tj
T* (if attempt == max_attempts:) Tj
T* (raise MaxRetriesExceededError\(f"Operation failed after {max_attempts} attempts"\) from te) Tj
T* (delay = backoff_base * \(2 ** \(attempt - 1\)\)) Tj
T* (time.sleep\(delay\)) Tj
T* () Tj
T* (counter = 0) Tj
T* (def intermittent_db_call\(\):) Tj
T* (global counter) Tj
T* (counter += 1) Tj
T* (if counter < 3:) Tj
T* (raise TimeoutError\("Database lock acquisition timeout"\)) Tj
T* (return "Database query committed successfully") Tj
T* () Tj
T* (retry_result = execute_with_retry\(intermittent_db_call, max_attempts=4\)) Tj
T* (print\(f") Tj
T* (Challenge 8 - Resilient Retry Mechanism:"\)) Tj
T* (print\(f" Execution Outcome: {retry_result} \(Succeeded on attempt {counter}\)"\)) Tj
ET
