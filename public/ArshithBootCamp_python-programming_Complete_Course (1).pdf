(import io) Tj
T* (import os) Tj
T* (import csv) Tj
T* (from pathlib import Path) Tj
T* (from collections import Counter) Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 1: Safe File Reader with Line, Word & Character Statistics) Tj
T* (# ==============================================================================) Tj
T* (def analyze_file_statistics\(file_stream\):) Tj
T* (total_lines = 0) Tj
T* (total_words = 0) Tj
T* (total_chars = 0) Tj
T* () Tj
T* (for line in file_stream:) Tj
T* (total_lines += 1) Tj
T* (total_chars += len\(line\)) Tj
T* (words = line.split\(\)) Tj
T* (total_words += len\(words\)) Tj
T* () Tj
T* (avg_chars = \(total_chars / total_lines\) if total_lines > 0 else 0) Tj
T* (return {) Tj
T* ("lines": total_lines,) Tj
T* ("words": total_words,) Tj
T* ("characters": total_chars,) Tj
T* ("avg_chars_per_line": round\(avg_chars, 2\)) Tj
T* (}) Tj
T* () Tj
T* (sample_doc = """Python is a high-level programming language designed for readability.) Tj
T* (File handling in Python connects persistent secondary storage with memory.) Tj
T* (Context managers guarantee that operating system resources are released cleanly.""") Tj
T* () Tj
T* (stats = analyze_file_statistics\(io.StringIO\(sample_doc\)\)) Tj
T* (print\("Challenge 1 - File Statistics:"\)) Tj
T* (for k, v in stats.items\(\):) Tj
T* (print\(f" {k:<20}: {v}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 2: MBOX Senders & Domain Aggregator) Tj
T* (# ==============================================================================) Tj
T* (sample_mbox = """From stephen.marquard@uct.ac.za Sat Jan 5 09:14:16 2008) Tj
T* (From: louis@media.berkeley.edu Fri Jan 4 18:10:48 2008) Tj
T* (From: zqian@umich.edu Fri Jan 4 16:10:39 2008) Tj
T* (From: rjlowe@iupui.edu Fri Jan 4 15:46:24 2008) Tj
T* (From: csev@umich.edu Fri Jan 4 15:03:11 2008) Tj
T* (From: gsilver@umich.edu Fri Jan 4 11:11:52 2008""") Tj
T* () Tj
T* (def aggregate_mbox_domains\(mbox_stream\):) Tj
T* (domain_counter = Counter\(\)) Tj
T* () Tj
T* (for line in mbox_stream:) Tj
T* (line = line.rstrip\(\)) Tj
T* (# Filter for lines starting with 'From:') Tj
T* (if not line.startswith\("From:"\):) Tj
T* (continue) Tj
T* () Tj
T* (parts = line.split\(\)) Tj
T* (if len\(parts\) >= 2:) Tj
T* (email = parts[1]) Tj
T* (if "@" in email:) Tj
T* (domain = email.split\("@"\)[1]) Tj
T* (domain_counter[domain] += 1) Tj
T* () Tj
T* (return domain_counter) Tj
T* () Tj
T* (domains = aggregate_mbox_domains\(io.StringIO\(sample_mbox\)\)) Tj
T* (print\(") Tj
T* (Challenge 2 - MBOX Email Domains:"\)) Tj
T* (for domain, count in domains.most_common\(\):) Tj
T* (print\(f" Domain: {domain:<25} Count: {count}"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 3: Spam Confidence Metric Calculator & Threshold Filter) Tj
T* (# ==============================================================================) Tj
T* (sample_spam_data = """X-DSPAM-Confidence: 0.8475) Tj
T* (X-DSPAM-Probability: 0.0000) Tj
T* (X-DSPAM-Confidence: 0.6178) Tj
T* (X-DSPAM-Confidence: 0.8920) Tj
T* (X-DSPAM-Confidence: 0.9234) Tj
T* (X-DSPAM-Confidence: 0.7565""") Tj
T* () Tj
T* (def calculate_spam_metrics\(stream, threshold=0.8500\):) Tj
T* (confidences = []) Tj
T* () Tj
T* (for line in stream:) Tj
T* (line = line.rstrip\(\)) Tj
T* (if line.startswith\("X-DSPAM-Confidence:"\):) Tj
T* (try:) Tj
T* (val = float\(line.split\(":"\)[1].strip\(\)\)) Tj
T* (confidences.append\(val\)) Tj
T* (except ValueError:) Tj
T* (continue) Tj
T* () Tj
T* (if not confidences:) Tj
T* (return None) Tj
T* () Tj
T* (high_spam = [c for c in confidences if c >= threshold]) Tj
T* (return {) Tj
T* ("count": len\(confidences\),) Tj
T* ("total": sum\(confidences\),) Tj
T* ("min": min\(confidences\),) Tj
T* ("max": max\(confidences\),) Tj
T* ("average": sum\(confidences\) / len\(confidences\),) Tj
T* ("high_spam_count": len\(high_spam\)) Tj
T* (}) Tj
T* () Tj
T* (spam_results = calculate_spam_metrics\(io.StringIO\(sample_spam_data\), 0.8500\)) Tj
T* (print\(") Tj
T* (Challenge 3 - Spam Confidence Metrics:"\)) Tj
T* (print\(f" Total Records: {spam_results['count']}"\)) Tj
T* (print\(f" Average Score: {spam_results['average']:.4f}"\)) Tj
T* (print\(f" Min / Max: {spam_results['min']:.4f} / {spam_results['max']:.4f}"\)) Tj
T* (print\(f" Critical Spam \(>= 0.85\): {spam_results['high_spam_count']} detected"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 4: Formatted CSV Data Transformer & Honor Roll Filter) Tj
T* (# ==============================================================================) Tj
T* (raw_students_csv = """StudentID,Name,Midterm,Final,Projects) Tj
T* (1001,"Sharma, Ananya",88,94,96) Tj
T* (1002,"Patel, Rohan",72,68,75) Tj
T* (1003,"Verma, Priya",95,92,98) Tj
T* (1004,"Joseph, John",82,85,89""") Tj
T* () Tj
T* (def generate_honors_report\(input_csv_stream\):) Tj
T* (reader = csv.DictReader\(input_csv_stream\)) Tj
T* (output_buffer = io.StringIO\(\)) Tj
T* (writer = csv.writer\(output_buffer\)) Tj
T* (writer.writerow\(["StudentID", "Name", "WeightedAverage", "Status"]\)) Tj
T* () Tj
T* (honors_count = 0) Tj
T* (for row in reader:) Tj
T* (# Midterm 30%, Final 40%, Projects 30%) Tj
T* (midterm = float\(row["Midterm"]\)) Tj
T* (final = float\(row["Final"]\)) Tj
T* (projects = float\(row["Projects"]\)) Tj
T* (weighted_avg = \(midterm * 0.30\) + \(final * 0.40\) + \(projects * 0.30\)) Tj
T* () Tj
T* (if weighted_avg >= 85.0:) Tj
T* (writer.writerow\([row["StudentID"], row["Name"], f"{weighted_avg:.2f}", "Honors"]\)) Tj
T* (honors_count += 1) Tj
T* () Tj
T* (output_buffer.seek\(0\)) Tj
T* (return honors_count, output_buffer.getvalue\(\)) Tj
T* () Tj
T* (count, report = generate_honors_report\(io.StringIO\(raw_students_csv\)\)) Tj
T* (print\(f") Tj
T* (Challenge 4 - Honors Students Generated \({count} Qualified\):"\)) Tj
T* (print\(report.strip\(\)\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 5: Search & Replace Streaming Batch Processor) Tj
T* (# ==============================================================================) Tj
T* (def stream_search_and_replace\(input_stream, output_stream, search_str, replace_str\):) Tj
T* (replacements_made = 0) Tj
T* (for line in input_stream:) Tj
T* (occurrences = line.count\(search_str\)) Tj
T* (if occurrences > 0:) Tj
T* (replacements_made += occurrences) Tj
T* (line = line.replace\(search_str, replace_str\)) Tj
T* (output_stream.write\(line\)) Tj
T* (return replacements_made) Tj
T* () Tj
T* (source_text = """SERVER_URL = http://dev.arshithbootcamp.internal) Tj
T* (DATABASE_HOST = http://dev.arshithbootcamp.internal:5432) Tj
T* (API_ENDPOINT = http://dev.arshithbootcamp.internal/v1/auth""") Tj
T* () Tj
T* (in_stream = io.StringIO\(source_text\)) Tj
T* (out_stream = io.StringIO\(\)) Tj
T* () Tj
T* (rep_count = stream_search_and_replace\(in_stream, out_stream,) Tj
T* ("http://dev.arshithbootcamp.internal", "https://api.arshithgroup.com"\)) Tj
T* (print\(f") Tj
T* (Challenge 5 - Stream Replacement \({rep_count} replaced\):"\)) Tj
T* (print\(out_stream.getvalue\(\).strip\(\)\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 6: Text File Word Frequency with Stop-Word Removal) Tj
T* (# ==============================================================================) Tj
T* (STOP_WORDS = {"the", "is", "at", "which", "on", "and", "a", "an", "to", "in", "it", "with", "for",) Tj
T* ("of"}) Tj
T* () Tj
T* (def compute_meaningful_word_frequency\(text_stream, top_n=5\):) Tj
T* (counter = Counter\(\)) Tj
T* (total_words = 0) Tj
T* () Tj
T* (for line in text_stream:) Tj
T* (clean = line.lower\(\)) Tj
T* (for punct in ",.-;:!?"'\(\)":) Tj
T* (clean = clean.replace\(punct, " "\)) Tj
T* (words = clean.split\(\)) Tj
T* (for w in words:) Tj
T* (total_words += 1) Tj
T* (if w not in STOP_WORDS and len\(w\) > 2:) Tj
T* (counter[w] += 1) Tj
T* () Tj
T* (results = []) Tj
T* (for word, cnt in counter.most_common\(top_n\):) Tj
T* (pct = \(cnt / total_words\) * 100 if total_words > 0 else 0) Tj
T* (results.append\(\(word, cnt, round\(pct, 2\)\)\)) Tj
T* (return results) Tj
T* () Tj
T* (raw_notes = """Python is an interpreted high-level general-purpose programming language.) Tj
T* (Python dynamic typing and garbage collection support multiple programming paradigms.) Tj
T* (The language is designed with an emphasis on code readability and clean syntax.""") Tj
T* () Tj
T* (top_words = compute_meaningful_word_frequency\(io.StringIO\(raw_notes\), top_n=5\)) Tj
T* (print\(") Tj
T* (Challenge 6 - Top Informative Words \(Stop-words removed\):"\)) Tj
T* (for word, cnt, pct in top_words:) Tj
T* (print\(f" - {word:<15}: {cnt} occurrences \({pct}% of corpus\)"\)) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 7: Atomic Configuration Manager) Tj
T* (# ==============================================================================) Tj
T* (class AtomicConfigManager:) Tj
T* (def __init__\(self, filepath\):) Tj
T* (self.path = Path\(filepath\)) Tj
T* () Tj
T* (def write_config\(self, key_values\):) Tj
T* (temp_path = self.path.with_suffix\(".tmp"\)) Tj
T* (try:) Tj
T* (with open\(temp_path, "w", encoding="utf-8"\) as f:) Tj
T* (for k, v in key_values.items\(\):) Tj
T* (f.write\(f"{k}={v}) Tj
T* ("\)) Tj
T* (f.flush\(\)) Tj
T* (os.fsync\(f.fileno\(\)\)) Tj
T* (temp_path.replace\(self.path\)) Tj
T* (return True) Tj
T* (except Exception as e:) Tj
T* (if temp_path.exists\(\):) Tj
T* (temp_path.unlink\(\)) Tj
T* (return False) Tj
T* () Tj
T* (cfg_mgr = AtomicConfigManager\("scratch_app.cfg"\)) Tj
T* (success = cfg_mgr.write_config\({"PORT": 8080, "ENV": "production", "WORKERS": 4}\)) Tj
T* (print\(f") Tj
T* (Challenge 7 - Atomic Config Save Status: {'Success' if success else 'Failed'}"\)) Tj
T* (if Path\("scratch_app.cfg"\).exists\(\):) Tj
T* (Path\("scratch_app.cfg"\).unlink\(\) # Cleanup demo file) Tj
T* () Tj
T* () Tj
T* (# ==============================================================================) Tj
T* (# Challenge 8: Directory Tree Inventory & Disk Usage Auditor \(pathlib\)) Tj
T* (# ==============================================================================) Tj
T* (def audit_directory_inventory\(directory_path\):) Tj
T* (root = Path\(directory_path\)) Tj
T* (extension_counts = Counter\(\)) Tj
T* (extension_bytes = Counter\(\)) Tj
T* () Tj
T* (if not root.exists\(\):) Tj
T* (return None) Tj
T* () Tj
T* (for p in root.rglob\("*"\):) Tj
T* (if p.is_file\(\):) Tj
T* (ext = p.suffix.lower\(\) if p.suffix else "[no-ext]") Tj
T* (extension_counts[ext] += 1) Tj
T* (extension_bytes[ext] += p.stat\(\).st_size) Tj
T* () Tj
T* (summary = []) Tj
T* (for ext, count in extension_counts.most_common\(\):) Tj
T* (kb = extension_bytes[ext] / 1024) Tj
T* (summary.append\(\(ext, count, round\(kb, 2\)\)\)) Tj
T* (return summary) Tj
T* () Tj
T* (inventory = audit_directory_inventory\("."\)) Tj
T* (print\(") Tj
T* (Challenge 8 - Workspace File Inventory:"\)) Tj
T* (if inventory:) Tj
T* (for ext, count, kb in inventory[:6]:) Tj
T* (print\(f" {ext:<12}: {count:>4} files \({kb:>8.2f} KB\)"\)) Tj
ET
endstream
endobj
